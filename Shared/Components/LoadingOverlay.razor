@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Routing
@inject RepyPharma.Services.Abstractions.LoadingOperationState Loading
@inject IJSRuntime JS
@implements IAsyncDisposable

<NavigationLock ConfirmExternalNavigation="@Loading.IsProcessing" OnBeforeInternalNavigation="BlockNavigation" />
<dialog @ref="_dialog" class="global-loading-dialog" aria-modal="true" aria-labelledby="global-loading-title" aria-describedby="global-loading-help" tabindex="-1">
    <div class="global-loading-panel">
        <div class="global-loading-spinner" role="progressbar" aria-label="Processamento em andamento"></div>
        <h2 id="global-loading-title" aria-live="polite" aria-atomic="true">@Loading.Message</h2>
        <p id="global-loading-help">Aguarde a conclusão do processamento. Não feche ou atualize esta página.</p>
    </div>
</dialog>

@code {
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private bool? _lastBusy;
    protected override void OnInitialized() => Loading.Changed += HandleChanged;
    private void HandleChanged() => _ = InvokeAsync(StateHasChanged);
    private void BlockNavigation(LocationChangingContext context)
    {
        if (Loading.IsProcessing) context.PreventNavigation();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/loading-overlay.js");
        if (_module is not null && _lastBusy != Loading.IsProcessing)
        {
            _lastBusy = Loading.IsProcessing;
            await _module.InvokeVoidAsync("setBusy", _dialog, _lastBusy.Value);
        }
    }
    public async ValueTask DisposeAsync()
    {
        Loading.Changed -= HandleChanged;
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("setBusy", _dialog, false); await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }
}
