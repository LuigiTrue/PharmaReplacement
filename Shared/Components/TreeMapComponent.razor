@using ApexCharts
@using RepyPharma.Models
@using RepyPharma.Services.Interfaces
@inject IStockJsonService StockService

<ApexChart TItem="LocationSummary" Width="700" Height="700" Options="ChartOptions">

    <ApexPointSeries TItem="LocationSummary" Items="_locations" Name="Quantidade em estoque" ShowDataLabels="true"
                     SeriesType="SeriesType.Treemap" XValue="@(e => e.LocationName)" YValue="@(e => e.TotalQuantity)"
                     PointColor="@(e => GetPointColor(e))" OrderByDescending="e => e.Y" />

</ApexChart>

@code {
    private List<LocationSummary> _locations = new();

    private static readonly Dictionary<string, string> ColorMap = new()
    {
        { "997", "#4da6ff" }, // Farmácia Central — azul
        { "999", "#4dbb6e" }, // CAF — verde
        { "998", "#ffaa4d" }, // Farmácia Centro Cirúrgico — laranja
        { "1059", "#c084fc" }, // Fracionamento — roxo
        { "996", "#94a3b8" }, // Almoxarifado — cinza
    };

    private ApexChartOptions<LocationSummary> ChartOptions = new()
    {
        Chart = new Chart
        {
            Background = "transparent",
            Toolbar = new Toolbar { Show = false },
            ForeColor = "black"
        },
        Tooltip = new Tooltip
        {
            Theme = Mode.Dark
        },
        Legend = new Legend
        {
            Labels = new LegendLabels
            {
                Colors = "#e0e0e0"
            }
        },
        PlotOptions = new PlotOptions
        {
            Treemap = new PlotOptionsTreemap
            {
                EnableShades = false
            }
        },
        DataLabels = new DataLabels
        {
            Style = new DataLabelsStyle
            {
                Colors = new List<string> { "#ffffff" }
            }
        }
    };

    private string GetPointColor(LocationSummary location)
    {
        return ColorMap.TryGetValue(location.LocationId, out var color)
            ? color
            : "#546E7A";
    }

    protected override async Task OnInitializedAsync()
    {
        _locations = await StockService.GetLocationSummaryAsync();
    }
}