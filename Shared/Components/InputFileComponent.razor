@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inject PdfParserService Parser
@inject PdfValidationService Validator
@inject PdfStorageService Storage

<div class="update-input-file-shell">
    <FluentInputFile Id="my-file-uploader" Class="update-input-file" Mode="InputFileMode.SaveToTemporaryFolder" Multiple="false" MaximumFileCount="1"
                     MaximumFileSize="@(10*1024*1024)" Accept=".pdf" @bind-ProgressPercent="@ProgressPercent"
                     OnCompleted="@OnCompletedAsync" Style="height: var(--update-input-file-height, 18.75rem);">
        <ChildContent>
            <label for="my-file-uploader">
                <FluentIcon Value="@(new @Icons.Regular.Size32.ArrowUpload())" />
            </label>

            <div class="update-input-copy">
                Para atualizar, arraste aqui ou <label for="my-file-uploader">selecione</label>
                o arquivo do espelho de estoque<span style="color: red;">*</span>.
                <br />
                <em>Gere o espelho apenas dos estoques 996,997,999 e 1059 .</em>
            </div>
        </ChildContent>
    </FluentInputFile>
</div>

@if (Files.Any())
{
    <h4>File(s) uploaded:</h4>
    <ul>
        @foreach (var file in Files)
        {
            <li>
                <b>@file.Name</b> 🔹
                @($"{Decimal.Divide(file.Size, 1024):N} KB") 🔹
                @file.ContentType 🔹
                @file.LocalFile?.FullName
                @file.ErrorMessage
            </li>
        }
    </ul>
}

@code {

    int ProgressPercent = 0;
    FluentInputFileEventArgs[] Files = Array.Empty<FluentInputFileEventArgs>();

    private async Task OnCompletedAsync(IEnumerable<FluentInputFileEventArgs> files)
    {
        var file = files.First();
        var text = Parser.ExtractText(file.LocalFile.FullName);

        if (!Validator.IsValidHospitalStockPdf(text))
            throw new Exception("Este arquivo não é um relatório de estoque válido.");

        var produtos = Parser.ParseProducts(file.LocalFile.FullName);

        await Storage.SaveAsync(produtos);
    }
}
