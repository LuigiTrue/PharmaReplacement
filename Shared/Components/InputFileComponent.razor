@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using RepyPharma.Services.Import.Interfaces
@inject PdfParserService Parser
@inject PdfStorageService Storage
@inject IConsumptionAverageReportService ConsumptionAverageReportService
@inject ReplenishmentDataState ReplenishmentDataState
@inject ThemeState ThemeState

<div class="update-input-file-shell @(ThemeState.IsDarkMode ? "is-dark" : null)">
    <div class="update-input-heading">
        <strong>@Title</strong>
        <span>@Hint</span>
    </div>

    <FluentInputFile Id="@UploadId" Class="update-input-file" Mode="InputFileMode.SaveToTemporaryFolder" Multiple="false" MaximumFileCount="1"
                     MaximumFileSize="@(10*1024*1024)" Accept=".pdf" @bind-ProgressPercent="@ProgressPercent"
                     OnCompleted="@OnCompletedAsync" Style="height: 30vh; display: grid; padding: 30px">
        <ChildContent>
            <div class="label-content">
            <label for="@UploadId">
                <FluentIcon Value="@(new @Icons.Regular.Size32.ArrowUpload())" />
            </label>

            <div class="update-input-copy">
                @Description <label for="@UploadId">Selecionar arquivo</label><span style="color: red;">*</span>.
            </div>
            </div>
        </ChildContent>
    </FluentInputFile>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <p class="update-input-status @(_statusIsError ? "error" : "success")">@_statusMessage</p>
    }
</div>

@code {

    [Parameter] public string UploadId { get; set; } = "file-uploader";
    [Parameter] public string ImportMode { get; set; } = "stock";
    [Parameter] public string Title { get; set; } = "Importar arquivo";
    [Parameter] public string Description { get; set; } = "Arraste aqui ou selecione o arquivo.";
    [Parameter] public string Hint { get; set; } = string.Empty;

    private int ProgressPercent = 0;
    private FluentInputFileEventArgs[] Files = Array.Empty<FluentInputFileEventArgs>();
    private string? _statusMessage;
    private bool _statusIsError;

    private async Task OnCompletedAsync(IEnumerable<FluentInputFileEventArgs> files)
    {
        Files = files.ToArray();
        var file = Files.FirstOrDefault();
        if (file?.LocalFile is null)
            return;

        _statusMessage = null;
        _statusIsError = false;

        try
        {
            if (ImportMode.Equals("consumption", StringComparison.OrdinalIgnoreCase))
                await ImportConsumptionReportAsync(file.LocalFile.FullName);
            else
                await ImportStockMirrorAsync(file.LocalFile.FullName);
        }
        catch (Exception ex)
        {
            _statusIsError = true;
            _statusMessage = ex.Message;
        }
    }

    private async Task ImportStockMirrorAsync(string filePath)
    {
        var validation = Parser.ValidateStockMirrorPdf(filePath);
        if (!validation.IsValid)
        {
            _statusIsError = true;
            _statusMessage = validation.Message;
            return;
        }

        var produtos = Parser.ParseProducts(filePath);

        await Storage.SaveAsync(produtos);
        _statusMessage = $"Espelho de estoque importado com {produtos.Count} itens.";
    }

    private async Task ImportConsumptionReportAsync(string filePath)
    {
        var validation = ConsumptionAverageReportService.ValidateConsumptionReportPdf(filePath);
        if (!validation.IsValid)
        {
            _statusIsError = true;
            _statusMessage = validation.Message;
            return;
        }

        var result = await ConsumptionAverageReportService.ImportPdfAsync(filePath);

        if (result.Errors > 0)
        {
            _statusIsError = true;
            _statusMessage = $"Relatório processado com {result.Errors} erro(s). {string.Join(" ", result.ErrorMessages.Take(2))}";
            return;
        }

        ReplenishmentDataState.NotifyChanged();
        _statusMessage = $"Relatório de consumo importado. {result.CreatedRecords} novos, {result.UpdatedRecords} atualizados.";
    }
}
