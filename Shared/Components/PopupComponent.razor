@using Microsoft.FluentUI.AspNetCore.Components
@implements IDialogContentComponent

@if (Dialog != null)
{
<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentLabel Typo="Typography.PaneHeader">
            @Dialog.Instance.Parameters.Title
        </FluentLabel>
    </FluentStack>
</FluentDialogHeader>

 <section class="update-popup-body">
     <InputFileComponent UploadId="stock-file-uploader"
                         Title="Importar espelho de estoque"
                         Description="Arraste aqui ou selecione o arquivo do espelho de estoque."
                         Hint="Gere o espelho apenas dos estoques 996, 997, 999 e 1059." />
</section>

<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Neutral" OnClick="@CancelAsync">Fechar</FluentButton>
</FluentDialogFooter>
}

@code {

    [CascadingParameter]
    public FluentDialog? Dialog { get; set; }

    private async Task CancelAsync()
    {
        if (Dialog is not null)
            await Dialog.CancelAsync();
    }
}
