@using RepyPharma.Models
@using Microsoft.FluentUI.AspNetCore.Components

<div class="dashboard-section">
    <div class="section-header">
        <span class="section-title">@Title</span>
        <span class="badge @BadgeClass">@BadgeLabel</span>
    </div>

    @if (!Items.Any())
    {
        <p class="empty-msg">Nenhum item nesta categoria.</p>
    }
    else
    {
        <FluentDataGrid Items="@_visibleItems" AutoFit="true">
            <TemplateColumn Title="Prioridade" Sortable="true">
                <ChildContent>
                    <span class="priority-chip @context.ItemPriority.ToString().ToLower()">
                        @context.ItemPriority
                    </span>
                </ChildContent>
            </TemplateColumn>
            <PropertyColumn Property="@(x => x.Code)" Title="Código" Sortable="true" />
            <PropertyColumn Property="@(x => x.Name)" Title="Nome" Sortable="true" />
            <PropertyColumn Property="@(x => x.Unit)" Title="Unidade" Sortable="true" />
            <PropertyColumn Property="@(x => x.CurrentStock)" Title="Estoque Atual" Sortable="true" />
            <PropertyColumn Property="@(x => x.MinimumQuantity)" Title="Mínimo" Sortable="true" />
            <PropertyColumn Property="@(x => x.MissingQuantity)" Title="Faltante" Sortable="true" />
        </FluentDataGrid>

        @if (Items.Count > 4)
        {
            <button class="ver-btn" @onclick="@ToggleShowAll">
                @(_showAll ? "Ver menos" : $"Ver todos ({Items.Count})")
            </button>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string BadgeClass { get; set; } = "";
    [Parameter, EditorRequired] public string BadgeLabel { get; set; } = "";
    [Parameter, EditorRequired] public List<ReplenishmentItem> Items { get; set; } = new();

    private bool _showAll = false;
    private IQueryable<ReplenishmentItem> _visibleItems = Enumerable.Empty<ReplenishmentItem>().AsQueryable();

    protected override async Task OnParametersSetAsync()
    {
        await UpdateVisibleItems();
    }

    private async Task ToggleShowAll()
    {
        _showAll = !_showAll;
        await UpdateVisibleItems();
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateVisibleItems()
    {
        _visibleItems = (_showAll ? Items : Items.Take(4))
            .AsQueryable();
    }
}