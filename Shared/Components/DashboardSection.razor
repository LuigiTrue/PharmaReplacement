@using RepyPharma.Models

<section class="app-grid-card mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <div class="mb-3 flex items-center justify-between gap-3">
        <span class="text-sm font-semibold text-slate-900 dark:text-slate-100">@Title</span>
        <div class="inline-flex items-center gap-2 rounded-lg border px-3 py-1.5 text-xs font-semibold shadow-sm @BadgeClassName">
            <span class="h-2 w-2 rounded-full @BadgeDotClass"></span>
            <span>@BadgeLabel</span>
        </div>
    </div>

    @if (!Items.Any())
    {
        <p class="text-sm text-slate-500 dark:text-slate-400">Nenhum item nesta categoria.</p>
    }
    else
    {
        <div class="app-grid overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-700">
            <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-700">
                <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-800 dark:text-slate-300">
                    <tr>
                        <th scope="col" class="px-4 py-3 text-left font-semibold">Prioridade</th>
                        <th scope="col" class="px-4 py-3 text-left font-semibold">Código</th>
                        <th scope="col" class="px-4 py-3 text-left font-semibold">Nome</th>
                        <th scope="col" class="px-4 py-3 text-right font-semibold">Estoque Atual</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white text-slate-700 dark:divide-slate-800 dark:bg-slate-900 dark:text-slate-100">
                    @foreach (var item in _visibleItems)
                    {
                        <tr class="transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/70">
                            <td class="px-4 py-3 align-top">
                                <span class="inline-flex rounded-full px-2 py-1 text-xs font-semibold @PriorityClass(item.ItemPriority)">
                                    @item.ItemPriority
                                </span>
                            </td>
                            <td class="whitespace-nowrap px-4 py-3 align-top font-medium text-slate-900 dark:text-slate-100">@item.Code</td>
                            <td class="min-w-72 px-4 py-3 align-top">@item.Name</td>
                            <td class="whitespace-nowrap px-4 py-3 text-right align-top tabular-nums">@item.CurrentStock</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Items.Count > 4)
        {
            <button class="mt-3 text-sm font-medium text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-300 dark:hover:text-blue-200" @onclick="@ToggleShowAll">
                @(_showAll ? "Ver menos" : $"Ver todos ({Items.Count})")
            </button>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string BadgeClass { get; set; } = "";
    [Parameter, EditorRequired] public string BadgeLabel { get; set; } = "";
    [Parameter, EditorRequired] public List<ReplenishmentItem> Items { get; set; } = new();

    private bool _showAll = false;
    private IReadOnlyList<ReplenishmentItem> _visibleItems = Array.Empty<ReplenishmentItem>();

    private string BadgeClassName => BadgeClass switch
    {
        "danger" => "border-red-200 bg-red-50 text-red-700 dark:border-red-900 dark:bg-slate-800 dark:text-red-300",
        "warning" => "border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-900 dark:bg-slate-800 dark:text-amber-300",
        "info" => "border-blue-200 bg-blue-50 text-blue-700 dark:border-blue-900 dark:bg-slate-800 dark:text-blue-300",
        _ => "border-slate-200 bg-slate-100 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
    };

    private string BadgeDotClass => BadgeClass switch
    {
        "danger" => "bg-red-500 dark:bg-red-300",
        "warning" => "bg-amber-500 dark:bg-amber-300",
        "info" => "bg-blue-500 dark:bg-blue-300",
        _ => "bg-slate-500 dark:bg-slate-300"
    };

    protected override void OnParametersSet()
    {
        UpdateVisibleItems();
    }

    private void ToggleShowAll()
    {
        _showAll = !_showAll;
        UpdateVisibleItems();
    }

    private void UpdateVisibleItems()
    {
        _visibleItems = (_showAll ? Items : Items.Take(4)).ToList();
    }

    private static string PriorityClass(ItemPriority priority) => priority switch
    {
        ItemPriority.UltraHigh => "border border-red-200 bg-red-50 text-red-700 dark:border-red-900 dark:bg-slate-800 dark:text-red-300",
        ItemPriority.High => "border border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-900 dark:bg-slate-800 dark:text-amber-300",
        ItemPriority.Moderate => "border border-blue-200 bg-blue-50 text-blue-700 dark:border-blue-900 dark:bg-slate-800 dark:text-blue-300",
        ItemPriority.Low => "border border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-900 dark:bg-slate-800 dark:text-emerald-300",
        _ => "border border-slate-200 bg-slate-100 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
    };
}
