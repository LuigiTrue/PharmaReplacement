@using RepyPharma.ViewModels
@typeparam TItem

<div class="app-grid overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-700">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-800 dark:text-slate-300">
            <tr>
                @foreach (var column in Columns)
                {
                    <th scope="col" class="px-4 py-3 text-left font-semibold">
                        @column.Title
                    </th>
                }
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-slate-700 dark:divide-slate-800 dark:text-slate-100">
            @if (!Items.Any())
            {
                <tr>
                    <td colspan="@Columns.Count" class="px-4 py-6 text-center text-slate-500 dark:text-slate-400">
                        Nenhum registro encontrado.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Items)
                {
                    <tr class="transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/70">
                        @foreach (var column in Columns)
                        {
                            <td class="px-4 py-3 align-top">
                                @GetColumnValue(column, item)
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired]
    public IQueryable<TItem> Items { get; set; } = Enumerable.Empty<TItem>().AsQueryable();

    [Parameter, EditorRequired]
    public List<GridColumnDefinition<TItem>> Columns { get; set; } = new();

    private static object? GetColumnValue(GridColumnDefinition<TItem> column, TItem item)
    {
        return column.Property.Compile()(item);
    }
}
