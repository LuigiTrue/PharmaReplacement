@using Microsoft.FluentUI.AspNetCore.Components
@using RepyPharma.ViewModels
@typeparam TItem

<div class="grid" style="width: 100%; overflow-x:auto;">

    <FluentDataGrid Items="Items" AutoFit="true">

        @foreach (var column in Columns)
        {
            <TemplateColumn Title="@column.Title" Sortable="column.Sortable">
                <ChildContent>
                    @column.Property.Compile()(context)
                </ChildContent>
            </TemplateColumn>
        }

    </FluentDataGrid>
</div>

@code {
    [Parameter, EditorRequired]
    public IQueryable<TItem> Items { get; set; } = default!;

    [Parameter, EditorRequired]
    public List<GridColumnDefinition<TItem>> Columns { get; set; } = new();
}