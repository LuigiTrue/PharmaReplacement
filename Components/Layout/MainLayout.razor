@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.FluentUI.AspNetCore.Components
@inject ThemeState ThemeState


<FluentDesignTheme Mode="@ThemeMode" />

<div class="layout-container @ThemeClass">

    <div class="page">

       @* <div class="sidebar">
            <NavMenu />
        </div>*@
        <NavMenuOutlaw></NavMenuOutlaw>
            
        

        <main>
            @*<div class="top-row px-4" style="background-color: var(--fluent-theme-color);">
                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
            </div> *@

            <div class="body-content">
                @Body
            </div>

        <footer class="app-footer">
            © @DateTime.Now.Year RepyPharma • Desenvolvido por Luigi Paoli
        </footer>
        </main>
    </div>
</div>


<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private DesignThemeModes ThemeMode => ThemeState.IsDarkMode
        ? DesignThemeModes.Dark
        : DesignThemeModes.Light;

    private string ThemeClass => ThemeState.IsDarkMode ? "theme-dark" : "theme-light";

    protected override void OnInitialized()
    {
        ThemeState.OnChange += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeState.OnChange -= OnThemeChanged;
    }
}
