@inherits LayoutComponentBase
@using Microsoft.FluentUI.AspNetCore.Components


<FluentDesignTheme Mode="DesignThemeModes.Dark" />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="header top-row px-4">
            <FluentPersona Name="Luigi" Status="PresenceStatus.Offline" StatusSize="PresenceBadgeSize.Small"
                           StatusTitle="Anonymous user is offline"
                           Image="@(new Icons.Regular.Size48.Person().ToDataUri(size: "25px", color: "white"))" ImageSize="40px">
            </FluentPersona>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>



<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
