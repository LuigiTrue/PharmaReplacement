@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.FluentUI.AspNetCore.Components
@inject ThemeState ThemeState
@inject IAuthService AuthService
@inject IUserSettingsService UserSettingsService


<FluentDesignTheme Mode="@ThemeMode" />

<div class="layout-container @ThemeClass">

    <div class="page">

       @* <div class="sidebar">
            <NavMenu />
        </div>*@
        <NavMenuOutlaw></NavMenuOutlaw>
            
        

        <main>
            <header class="app-main-header">
                <div class="app-main-header-brand">
                    <span class="app-main-header-icon" aria-hidden="true">
                        <i class="bi bi-hospital-fill"></i>
                    </span>
                    <span class="app-main-header-title">RepyPharma</span>
                </div>

                <div class="app-main-header-actions">
                    <div class="app-notification-menu">
                        <button type="button"
                                class="app-notification-button"
                                title="Notificações"
                                aria-label="Notificações"
                                aria-expanded="@_notificationsOpen"
                                disabled="@(!HasNotifications)"
                                @onclick="ToggleNotificationsAsync">
                            <i class="bi bi-bell-fill" aria-hidden="true"></i>
                            @if (HasNotifications)
                            {
                                <span class="app-notification-dot" aria-hidden="true"></span>
                                <span class="app-notification-count">@_pendingPasswordRequests</span>
                            }
                        </button>

                        @if (_notificationsOpen && HasNotifications)
                        {
                            <div class="app-notification-dropdown" role="status" aria-label="Notificações pendentes">
                                @foreach (var notification in _passwordRequestNotifications)
                                {
                                    <p class="app-notification-text">@GetPasswordRequestNotificationText(notification)</p>
                                }
                            </div>
                        }
                    </div>

                    <UserIdentityBadge />
                </div>
            </header>

            <div class="body-content">
                @Body
            </div>

        <footer class="app-footer">
            © @DateTime.Now.Year RepyPharma • Desenvolvido por Luigi Paoli
        </footer>
        </main>
    </div>
</div>


<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private List<UserPasswordChangeRequest> _passwordRequestNotifications = new();
    private bool _notificationsOpen;

    private int _pendingPasswordRequests => _passwordRequestNotifications.Count;

    private bool HasNotifications => AuthService.IsAdmin && _pendingPasswordRequests > 0;

    private DesignThemeModes ThemeMode => ThemeState.IsDarkMode
        ? DesignThemeModes.Dark
        : DesignThemeModes.Light;

    private string ThemeClass => ThemeState.IsDarkMode ? "theme-dark dark" : "theme-light";

    protected override void OnInitialized()
    {
        ThemeState.OnChange += OnThemeChanged;
        AuthService.OnChange += OnThemeChanged;
        UserSettingsService.OnChange += OnUserSettingsChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadNotificationsAsync();
    }

    private void OnThemeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeState.OnChange -= OnThemeChanged;
        AuthService.OnChange -= OnThemeChanged;
        UserSettingsService.OnChange -= OnUserSettingsChanged;
    }

    private async void OnUserSettingsChanged()
    {
        await LoadNotificationsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadNotificationsAsync()
    {
        _passwordRequestNotifications = AuthService.IsAdmin
            ? await UserSettingsService.GetPendingPasswordRequestsAsync()
            : new List<UserPasswordChangeRequest>();

        if (!HasNotifications)
            _notificationsOpen = false;
    }

    private async Task ToggleNotificationsAsync()
    {
        if (_notificationsOpen)
        {
            _notificationsOpen = false;
            return;
        }

        await LoadNotificationsAsync();
        _notificationsOpen = HasNotifications;
    }

    private static string GetPasswordRequestNotificationText(UserPasswordChangeRequest notification)
    {
        var displayName = !string.IsNullOrWhiteSpace(notification.Name)
            ? notification.Name
            : !string.IsNullOrWhiteSpace(notification.Username)
                ? notification.Username
                : "Um usuário";

        return $"{displayName} deseja alterar a senha.";
    }

    private async Task AtualizarVersaoAsync()
    {
        // sua lógica real de atualização aqui
        await Task.CompletedTask;
    }
}
