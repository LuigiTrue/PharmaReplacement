@inject LayoutState LayoutState

<div class="nav-scrollable @(LayoutState.IsMenuCollapsed ? "collapsed" : "")">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/Dashboard">
                <span class="bi bi-house-door-fill-nav-menu"></span>
                @if (!LayoutState.IsMenuCollapsed)
                {
                    <span> Início</span>
                }
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/Replacement/ReplacementGrid">
                <span class="bi bi-plus-square-fill-nav-menu"></span>
                @if (!LayoutState.IsMenuCollapsed)
                {
                    <span> Reposição </span>
                }
            </NavLink>
        </div>
        @*
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/Dialog">
                <span class="bi bi-list-nested-nav-menu"></span>
                @if (!LayoutState.IsMenuCollapsed)
                {
                    <span> Configurações</span>
                }
            </NavLink>
        </div>
*@
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        LayoutState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        LayoutState.OnChange -= StateHasChanged;
    }
}