@page "/Shopping/ShoppingMain"
@attribute [Authorize(Roles = "Admin,Farmacia,Almoxarifado")]
@using RepyPharma.Components.Pages.Shopping.Configuration
@using RepyPharma.Components.Pages.Shopping.Dashboard
@using RepyPharma.Components.Pages.Shopping.Grid

<PageTitle>Compras</PageTitle>

<div class="shopping-shell">
    <section class="app-grid-card shopping-header-card mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <div>
            <h3 class="shopping-title">Compras</h3>
            <p class="shopping-description">Importações mensais por estoque</p>
        </div>
    </section>

    <div class="shopping-tabs-host">
        <input class="shopping-tab-input" type="radio" name="shopping-tabs" id="shopping-tab-grid" checked />
        <input class="shopping-tab-input" type="radio" name="shopping-tabs" id="shopping-tab-dashboard" />
        <input class="shopping-tab-input" type="radio" name="shopping-tabs" id="shopping-tab-configuration" />

        <div class="app-tabs" role="tablist" aria-label="Seções de compras">
            <label class="app-tab" role="tab" for="shopping-tab-grid">Grid</label>
            <label class="app-tab" role="tab" for="shopping-tab-dashboard">Dashboard</label>
            <label class="app-tab" role="tab" for="shopping-tab-configuration">Configurações</label>
        </div>

        <div class="shopping-tab-panel shopping-grid-panel" role="tabpanel">
            <ShoppingGrid />
        </div>

        <div class="shopping-tab-panel shopping-dashboard-panel" role="tabpanel">
            <ShoppingDashboard />
        </div>

        <div class="shopping-tab-panel shopping-configuration-panel" role="tabpanel">
            <ShoppingConfiguration />
        </div>
    </div>
</div>
