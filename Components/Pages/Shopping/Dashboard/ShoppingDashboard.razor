<section class="shopping-dashboard-layout" aria-label="Resumo das importações de compras">
    <div class="shopping-dashboard-metrics">
        <article class="shopping-metric-card">
            <p>Relatórios importados</p>
            <strong>28<span>/36</span></strong>
            <small class="completed"><i class="bi bi-arrow-up-right" aria-hidden="true"></i> 4 neste mês</small>
        </article>
        <article class="shopping-metric-card">
            <p>Estoques atualizados</p>
            <strong>2<span>/3</span></strong>
            <small class="processing"><i class="bi bi-clock" aria-hidden="true"></i> Julho/2026</small>
        </article>
        <article class="shopping-metric-card">
            <p>Relatórios pendentes</p>
            <strong>8</strong>
            <small class="pending"><i class="bi bi-calendar3" aria-hidden="true"></i> Período acompanhado</small>
        </article>
        <article class="shopping-metric-card">
            <p>Itens com pendência</p>
            <strong>14</strong>
            <small class="invalid"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Requer validação</small>
        </article>
    </div>

    <div class="shopping-dashboard-content">
        <section class="shopping-dashboard-panel">
            <div class="shopping-dashboard-panel-heading">
                <div>
                    <h4>Regularidade das importações</h4>
                    <p>Últimos seis meses</p>
                </div>
                <span class="shopping-dashboard-value">78%</span>
            </div>
            <div class="shopping-bar-chart" role="img" aria-label="Importações concluídas de fevereiro a julho de 2026">
                <div class="shopping-bar-column"><span style="height: 72%"></span><small>Fev</small></div>
                <div class="shopping-bar-column"><span style="height: 88%"></span><small>Mar</small></div>
                <div class="shopping-bar-column"><span style="height: 58%"></span><small>Abr</small></div>
                <div class="shopping-bar-column"><span style="height: 76%"></span><small>Mai</small></div>
                <div class="shopping-bar-column"><span style="height: 92%"></span><small>Jun</small></div>
                <div class="shopping-bar-column current"><span style="height: 66%"></span><small>Jul</small></div>
            </div>
        </section>

        <section class="shopping-dashboard-panel">
            <div class="shopping-dashboard-panel-heading">
                <div>
                    <h4>Situação por estoque</h4>
                    <p>Referência: julho de 2026</p>
                </div>
            </div>
            <div class="shopping-location-list">
                <div><span>Farmácia Central</span><strong class="completed"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Atualizado</strong></div>
                <div><span>Centro Cirúrgico</span><strong class="processing"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Em validação</strong></div>
                <div><span>CAF</span><strong class="pending"><i class="bi bi-dash-circle-fill" aria-hidden="true"></i> Pendente</strong></div>
            </div>
        </section>
    </div>
</section>
