<section class="shopping-grid-layout" aria-label="Importações mensais por estoque">
    <div class="shopping-grid-heading">
        <div>
            <h4>Importações por estoque</h4>
            <p>Referência: julho de 2026</p>
        </div>
        <span class="shopping-grid-period"><i class="bi bi-calendar3" aria-hidden="true"></i> Últimos 36 meses</span>
    </div>

    <div class="shopping-grid-table-wrap">
        <table class="shopping-grid-table">
            <thead>
                <tr>
                    <th scope="col">Estoque</th>
                    <th scope="col">Fev</th>
                    <th scope="col">Mar</th>
                    <th scope="col">Abr</th>
                    <th scope="col">Mai</th>
                    <th scope="col">Jun</th>
                    <th scope="col">Jul</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">Farmácia Central</th>
                    <td><span class="report-status completed" title="Importado"><i class="bi bi-check-lg" aria-hidden="true"></i></span></td>
                    <td><span class="report-status completed" title="Importado"><i class="bi bi-check-lg" aria-hidden="true"></i></span></td>
                    <td><span class="report-status completed" title="Importado"><i class="bi bi-check-lg" aria-hidden="true"></i></span></td>
                    <td><span class="report-status completed" title="Importado"><i class="bi bi-check-lg" aria-hidden="true"></i></span></td>
                    <td><span class="report-status completed" title="Importado"><i class="bi bi-check-lg" aria-hidden="true"></i></span></td>
                    <td><span class="report-status completed" title="Importado"><i class="bi bi-check-lg" aria-hidden="true"></i></span></td>
                </tr>
                <tr>
                    <th scope="row">Centro Cirúrgico</th>
                    <td><span class="report-status completed" title="Importado"><i class="bi bi-check-lg" aria-hidden="true"></i></span></td>
                    <td><span class="report-status completed" title="Importado"><i class="bi bi-check-lg" aria-hidden="true"></i></span></td>
                    <td><span class="report-status pending" title="Pendente"><i class="bi bi-dash" aria-hidden="true"></i></span></td>
                    <td><span class="report-status completed" title="Importado"><i class="bi bi-check-lg" aria-hidden="true"></i></span></td>
                    <td><span class="report-status completed" title="Importado"><i class="bi bi-check-lg" aria-hidden="true"></i></span></td>
                    <td><span class="report-status processing" title="Em validação"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></span></td>
                </tr>
                <tr>
                    <th scope="row">CAF</th>
                    <td><span class="report-status completed" title="Importado"><i class="bi bi-check-lg" aria-hidden="true"></i></span></td>
                    <td><span class="report-status invalid" title="Com pendência"><i class="bi bi-exclamation-lg" aria-hidden="true"></i></span></td>
                    <td><span class="report-status completed" title="Importado"><i class="bi bi-check-lg" aria-hidden="true"></i></span></td>
                    <td><span class="report-status pending" title="Pendente"><i class="bi bi-dash" aria-hidden="true"></i></span></td>
                    <td><span class="report-status completed" title="Importado"><i class="bi bi-check-lg" aria-hidden="true"></i></span></td>
                    <td><span class="report-status pending" title="Pendente"><i class="bi bi-dash" aria-hidden="true"></i></span></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="shopping-grid-legend" aria-label="Legenda de status">
        <span><i class="bi bi-check-circle-fill completed" aria-hidden="true"></i> Importado</span>
        <span><i class="bi bi-arrow-repeat processing" aria-hidden="true"></i> Em validação</span>
        <span><i class="bi bi-exclamation-circle-fill invalid" aria-hidden="true"></i> Com pendência</span>
        <span><i class="bi bi-dash-circle-fill pending" aria-hidden="true"></i> Pendente</span>
    </div>
</section>
