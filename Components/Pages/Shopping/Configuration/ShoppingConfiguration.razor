<section class="shopping-configuration-layout" aria-label="Configurações de compras">
    <div class="shopping-configuration-heading">
        <div>
            <h4>Configuração do acompanhamento</h4>
            <p>Parâmetros da visualização mensal</p>
        </div>
    </div>

    <div class="shopping-configuration-form">
        <label class="shopping-configuration-field">
            <span>Período acompanhado</span>
            <input value="36 meses" readonly />
        </label>
        <label class="shopping-configuration-field">
            <span>Status considerado atualizado</span>
            <input value="Concluído" readonly />
        </label>
        <label class="shopping-configuration-field">
            <span>Referência inicial</span>
            <input value="Agosto de 2023" readonly />
        </label>
    </div>

    <section class="shopping-configuration-panel">
        <div class="shopping-configuration-panel-heading">
            <div>
                <h5>Estoques acompanhados</h5>
                <p>Locais exibidos no grid administrativo</p>
            </div>
            <span class="shopping-configuration-count">3 locais</span>
        </div>
        <div class="shopping-configuration-locations">
            <div><i class="bi bi-box-seam" aria-hidden="true"></i><span>Farmácia Central</span><small>Ativo</small></div>
            <div><i class="bi bi-box-seam" aria-hidden="true"></i><span>Centro Cirúrgico</span><small>Ativo</small></div>
            <div><i class="bi bi-box-seam" aria-hidden="true"></i><span>CAF</span><small>Ativo</small></div>
        </div>
    </section>
</section>
