            new() { Id = 2, Code = "PE-2026-002", Sector = "Centro cirúrgico", ItemCode = "MAT-008", ItemDescription = "Cateter venoso periférico 22 G", Quantity = 500, CreatedAt = ReferenceDate, Deadline = ReferenceDate.AddDays(1), Priority = EmergencyPriority.Critical, Status = EmergencyStatus.InQuotation, Reason = "Necessidade ilustrativa para a programação de procedimentos do centro cirúrgico." },
            new() { Id = 3, Code = "PE-2026-003", Sector = "Emergência", ItemCode = "MED-002", ItemDescription = "Meropeném 1 g", Quantity = 200, CreatedAt = new(2026, 11, 20), Deadline = ReferenceDate.AddDays(3), Priority = EmergencyPriority.High, Status = EmergencyStatus.OrderSent, Reason = "Exemplo de solicitação com pedido enviado e entrega em acompanhamento." },
            new() { Id = 4, Code = "PE-2026-004", Sector = "Enfermaria", ItemCode = "MED-012", ItemDescription = "Paracetamol 750 mg", Quantity = 7000, CreatedAt = new(2026, 11, 10), Deadline = new(2026, 11, 16), Priority = EmergencyPriority.Moderate, Status = EmergencyStatus.Completed, InvoiceId = 7, Reason = "Exemplo concluído de aquisição com nota fiscal vinculada para consulta." }
        ]);
    }
    private static DemoInvoice Invoice(int id, string number, int supplier, decimal value, int month, int day, int itemCount, DateOnly? paidDate = null) => new()
    { Id = id, Number = number, SupplierId = supplier, Value = value, ItemCount = itemCount, Quotation = Quotations[(id - 1) % Quotations.Length], IssueDate = new(2026, 11, 10), ReceivedDate = new(2026, 11, 12), DueDate = new(2026, month, day), Receiver = "Equipe de recebimento · demonstração", PaymentMethod = "Boleto", PaidDate = paidDate };
    private void HandleAuthChanged() => _ = InvokeAsync(StateHasChanged);
    private void ClearInvoiceSelection() => _selectedInvoiceId = null;
    private void ClearRequestSelection() => _selectedRequestId = null;
    private void ResetInvoiceFilters() { _invoiceSearch = _supplierFilter = ""; _paymentFilter = "open"; ClearInvoiceSelection(); }
    private void ResetRequestFilters() { _requestSearch = _priorityFilter = ""; _requestStatus = "active"; ClearRequestSelection(); }
    private void OpenInvoice(int invoiceId) { ResetInvoiceFilters(); _paymentFilter = "all"; _selectedInvoiceId = invoiceId; _activeTab = 0; }
    private void SimulatePayment(DemoInvoice invoice)
    {
        if (!CanEdit || invoice.IsPaid) return;
        invoice.PaidDate = ReferenceDate;
        _message = $"Pagamento da NF {invoice.Number} confirmado somente na demonstração. Nenhum dado foi gravado.";
        _paymentFilter = "paid";
        _invoiceSearch = _supplierFilter = "";
    }
    private void SelectInvoiceFile(InputFileChangeEventArgs args)
    {
        if (!CanEdit) return;
        _invoiceAttachment = null; _attachmentError = null;
        if (args.FileCount != 1) { _attachmentError = "Selecione apenas um documento por nota."; return; }
        var file = args.File;
        var extension = Path.GetExtension(file.Name);
        if (!string.Equals(extension, ".pdf", StringComparison.OrdinalIgnoreCase) && !string.Equals(extension, ".xml", StringComparison.OrdinalIgnoreCase)) { _attachmentError = "Selecione um arquivo PDF ou XML."; return; }
        if (file.Size == 0 || file.Size > 10 * 1024 * 1024) { _attachmentError = "O documento deve ter conteúdo e tamanho de até 10 MB."; return; }
        _invoiceAttachment = file.Name;
    }
    private void RemoveInvoiceFile() { _invoiceAttachment = _attachmentError = null; _attachmentVersion++; }
    private void ResetInvoiceForm() { _invoiceForm = new(); _invoiceError = null; RemoveInvoiceFile(); }
    private void SimulateInvoiceRegistration()
    {
        if (!CanEdit || _attachmentError is not null) return;
        _invoiceError = null;
        if (_invoices.Any(i => i.SupplierId == _invoiceForm.SupplierId && string.Equals(i.Number, _invoiceForm.Number.Trim(), StringComparison.OrdinalIgnoreCase))) { _invoiceError = "Essa nota já está cadastrada para o fornecedor na demonstração."; return; }
        var invoice = new DemoInvoice { Id = _invoices.Max(i => i.Id) + 1, Number = _invoiceForm.Number.Trim(), SupplierId = _invoiceForm.SupplierId!.Value, Quotation = _invoiceForm.Quotation, Value = _invoiceForm.Value!.Value, ItemCount = _invoiceForm.ItemCount!.Value,
            IssueDate = _invoiceForm.IssueDate!.Value, ReceivedDate = _invoiceForm.ReceivedDate!.Value, DueDate = _invoiceForm.DueDate!.Value, Receiver = string.IsNullOrWhiteSpace(_invoiceForm.Receiver) ? "Não informado na demonstração" : _invoiceForm.Receiver.Trim(), PaymentMethod = _invoiceForm.PaymentMethod, AttachmentName = _invoiceAttachment, Notes = _invoiceForm.Notes,
            IsThermolabile = _invoiceForm.IsThermolabile, ContainsPurchase = _invoiceForm.ContainsPurchase };
        _invoices.Add(invoice);
        _message = $"NF {invoice.Number} incluída no acompanhamento apenas nesta sessão. Nenhum dado foi gravado.";
        ResetInvoiceForm();
        OpenInvoice(invoice.Id);
    }
    private void SimulateEmergencyRequest()
    {
        if (!CanEdit) return;
        var item = EmergencyItems.First(i => i.Code == _emergencyForm.ItemCode);
        var id = _requests.Max(r => r.Id) + 1;
        var request = new DemoEmergencyRequest { Id = id, Code = $"PE-2026-{id:000}", Sector = _emergencyForm.Sector, ItemCode = item.Code, ItemDescription = item.Description, Quantity = _emergencyForm.Quantity!.Value, CreatedAt = ReferenceDate, Deadline = _emergencyForm.Deadline!.Value, Priority = _emergencyForm.Priority, Status = EmergencyStatus.WaitingApproval, Reason = _emergencyForm.Reason.Trim() };
        _requests.Add(request);
        _emergencyForm = new(); _showEmergencyForm = false;
        ResetRequestFilters(); _selectedRequestId = request.Id;
        _message = $"Solicitação {request.Code} incluída apenas na demonstração. Nenhuma compra foi gerada.";
    }
    public void Dispose() => AuthService.OnChange -= HandleAuthChanged;

    private sealed record DemoSupplier(int Id, string Name);
    private sealed record EmergencyItem(string Code, string Description);
    private sealed class DemoInvoice
    {
        public int Id { get; init; }
        public string Number { get; init; } = "";
        public int SupplierId { get; init; }
        public string Quotation { get; init; } = "";
        public decimal Value { get; init; }
        public int ItemCount { get; init; }
        public DateOnly IssueDate { get; init; }
        public DateOnly ReceivedDate { get; init; }
        public DateOnly DueDate { get; init; }
        public string Receiver { get; init; } = "";
        public string PaymentMethod { get; init; } = "";
        public DateOnly? PaidDate { get; set; }
        public bool IsPaid => PaidDate is not null;
        public string? AttachmentName { get; init; }
        public string? Notes { get; init; }
        public bool IsThermolabile { get; init; }
        public bool ContainsPurchase { get; init; } = true;
    }
    private enum EmergencyPriority { Critical, High, Moderate }
    private enum EmergencyStatus { WaitingApproval, InQuotation, OrderSent, Completed }
    private sealed class DemoEmergencyRequest
    {
        public int Id { get; init; }
        public string Code { get; init; } = "";
        public string Sector { get; init; } = "";
        public string ItemCode { get; init; } = "";
        public string ItemDescription { get; init; } = "";
        public int Quantity { get; init; }
        public DateOnly CreatedAt { get; init; }
        public DateOnly Deadline { get; init; }
        public EmergencyPriority Priority { get; init; }
        public EmergencyStatus Status { get; init; }
        public string Reason { get; init; } = "";
        public int? InvoiceId { get; init; }
    }
    private sealed class InvoiceForm : IValidatableObject
    {
        [Required(ErrorMessage = "Informe o número da nota."), RegularExpression(@"\S(?:.*\S)?", ErrorMessage = "Informe um número de nota válido.")] public string Number { get; set; } = "";
        [Required(ErrorMessage = "Selecione o fornecedor.")] public int? SupplierId { get; set; }
        [Required(ErrorMessage = "Selecione a cotação.")] public string Quotation { get; set; } = "";
        [Required(ErrorMessage = "Informe o valor da nota."), Range(typeof(decimal), "0.01", "999999999", ParseLimitsInInvariantCulture = true, ErrorMessage = "Informe um valor maior que zero.")] public decimal? Value { get; set; }
        [Required(ErrorMessage = "Informe a quantidade de itens."), Range(1, 1000000, ErrorMessage = "Informe uma quantidade de itens maior que zero.")] public int? ItemCount { get; set; }
        public string PaymentMethod { get; set; } = "Boleto";
        [Required(ErrorMessage = "Informe a data de emissão.")] public DateOnly? IssueDate { get; set; } = ReferenceDate;
        [Required(ErrorMessage = "Informe a data de recebimento.")] public DateOnly? ReceivedDate { get; set; } = ReferenceDate;
        [Required(ErrorMessage = "Informe a data de vencimento.")] public DateOnly? DueDate { get; set; } = ReferenceDate.AddDays(15);
        public string Receiver { get; set; } = "";
        public bool IsThermolabile { get; set; }
        public bool ContainsPurchase { get; set; } = true;
        public string Notes { get; set; } = "";
        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (IssueDate.HasValue && ReceivedDate < IssueDate) yield return new("O recebimento não pode ser anterior à emissão.", [nameof(ReceivedDate)]);
            if (IssueDate.HasValue && DueDate < IssueDate) yield return new("O vencimento não pode ser anterior à emissão.", [nameof(DueDate)]);
        }
    }
    private sealed class EmergencyForm : IValidatableObject
    {
        [Required(ErrorMessage = "Selecione o setor solicitante.")] public string Sector { get; set; } = "";
        [Required(ErrorMessage = "Selecione o item solicitado.")] public string ItemCode { get; set; } = "";
        [Required(ErrorMessage = "Informe a quantidade."), Range(1, 1000000, ErrorMessage = "Informe uma quantidade maior que zero.")] public int? Quantity { get; set; }
        [Required(ErrorMessage = "Informe o prazo de necessidade.")] public DateOnly? Deadline { get; set; } = ReferenceDate.AddDays(1);
        public EmergencyPriority Priority { get; set; } = EmergencyPriority.High;
        [Required(ErrorMessage = "Informe a justificativa."), MinLength(10, ErrorMessage = "Descreva a justificativa com pelo menos 10 caracteres.")] public string Reason { get; set; } = "";
        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Deadline < ReferenceDate) yield return new("O prazo não pode ser anterior à referência da demonstração.", [nameof(Deadline)]);
        }
    }
}
