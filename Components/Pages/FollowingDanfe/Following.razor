@page "/FollowingDanfe/Following"
@attribute [Authorize(Roles = "Admin,Farmacia,Almoxarifado,Consulta")]
@using System.Globalization
@using System.ComponentModel.DataAnnotations
@inject IAuthService AuthService
@implements IDisposable

<PageTitle>Notas Fiscais | RepyPharma</PageTitle>

<div class="nf-module">
    <header class="nf-header">
        <div><div class="nf-eyebrow">GESTÃO HOSPITALAR · CONTROLE DE NOTAS FISCAIS</div><h1><i class="bi bi-receipt" aria-hidden="true"></i> Notas Fiscais</h1><p>Acompanhe vencimentos, organize os recebimentos e visualize os pedidos emergenciais.</p></div>
        <div class="nf-header-context"><span class="nf-demo-badge"><i class="bi bi-circle-fill" aria-hidden="true"></i> Ambiente demonstrativo — Dados fictícios</span><span class="nf-muted">Referência simulada · @ReferenceDate.ToString("dd/MM/yyyy", Br)</span></div>
    </header>
    <p class="nf-demo-note"><i class="bi bi-info-circle" aria-hidden="true"></i> Cadastros, pagamentos e pedidos são simulados. Nenhuma informação é gravada; as alterações são descartadas ao sair ou recarregar esta página.</p>
    <nav class="nf-tabs" role="tablist" aria-label="Seções de notas fiscais">
        @for (var index = 0; index < TabNames.Length; index++)
        {
            var tab = index;
            <button type="button" role="tab" id="@($"nf-tab-{tab}")" aria-controls="@($"nf-panel-{tab}")" aria-selected="@(tab == _activeTab ? "true" : "false")" class="@(tab == _activeTab ? "is-active" : null)" @onclick="() => _activeTab = tab"><i class="bi @TabIcons[tab]" aria-hidden="true"></i>@TabNames[tab]</button>
        }
    </nav>
    @if (!CanEdit) { <p class="nf-notice"><i class="bi bi-eye" aria-hidden="true"></i> Perfil de consulta: visualize os dados e detalhes. As simulações estão disponíveis para perfis com permissão de atualização.</p> }
    @if (_message is not null)
    {
        <div class="nf-feedback" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i><span>@_message</span><button type="button" class="nf-icon-button" aria-label="Fechar mensagem" @onclick="() => _message = null"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
    }

    <section id="nf-panel-0" role="tabpanel" aria-labelledby="nf-tab-0" hidden="@(_activeTab != 0)">
        <div class="nf-section-heading"><div><h2>Acompanhamento de pagamento</h2><p>Do vencimento mais próximo para o mais distante, com as notas vencidas no início.</p></div><span class="nf-status nf-neutral"><i class="bi bi-sort-down" aria-hidden="true"></i> Ordem de vencimento</span></div>
        <div class="nf-metrics">
            <article><span><i class="bi bi-currency-dollar" aria-hidden="true"></i> Total em aberto</span><strong>@Money(_invoices.Where(i => !i.IsPaid).Sum(i => i.Value))</strong><small>@_invoices.Count(i => !i.IsPaid) notas da amostra</small></article>
            <article><span><i class="bi bi-exclamation-circle nf-red-icon" aria-hidden="true"></i> Notas vencidas</span><strong>@_invoices.Count(i => !i.IsPaid && i.DueDate < ReferenceDate)</strong><small>Exigem acompanhamento prioritário</small></article>
            <article><span><i class="bi bi-calendar-event nf-amber-icon" aria-hidden="true"></i> Vencem em até 7 dias</span><strong>@_invoices.Count(i => !i.IsPaid && DaysUntilDue(i) is >= 0 and <= 7)</strong><small>Inclui vencimentos de hoje</small></article>
            <article><span><i class="bi bi-check-circle nf-green-icon" aria-hidden="true"></i> Notas pagas</span><strong>@_invoices.Count(i => i.IsPaid)</strong><small>Confirmações demonstrativas</small></article>
        </div>
        <section class="nf-card">
            <div class="nf-card-heading"><div><h3>Agenda de vencimentos</h3><p>Selecione uma nota para consultar os dados de recebimento e pagamento.</p></div><span class="nf-status nf-neutral" aria-live="polite">@FilteredInvoices.Count de @_invoices.Count notas</span></div>
            <div class="nf-filters">
                <label class="nf-control nf-grow"><span>Buscar NF ou fornecedor</span><input type="search" placeholder="Ex.: 000184, Vida Hospitalar" @bind="_invoiceSearch" @bind:event="oninput" @bind:after="ClearInvoiceSelection" /></label>
                <label class="nf-control"><span>Situação do pagamento</span><select aria-label="Filtrar notas por situação" @bind="_paymentFilter" @bind:after="ClearInvoiceSelection"><option value="open">Em aberto</option><option value="overdue">Vencidas</option><option value="week">Vencem em até 7 dias</option><option value="paid">Pagas</option><option value="all">Todas as notas</option></select></label>
                <label class="nf-control"><span>Fornecedor</span><select aria-label="Filtrar notas por fornecedor" @bind="_supplierFilter" @bind:after="ClearInvoiceSelection"><option value="">Todos os fornecedores</option>@foreach (var supplier in Suppliers) { <option value="@supplier.Id">@supplier.Name</option> }</select></label>
            </div>
            @if (HasInvoiceFilters) { <div class="nf-filter-summary"><span>Indicadores referem-se à amostra completa.</span><button type="button" class="nf-text-button" @onclick="ResetInvoiceFilters">Limpar filtros</button></div> }
            <div class="nf-table-scroll"><table class="nf-table nf-payment-table"><thead><tr><th>Vencimento</th><th>Nota fiscal</th><th>Fornecedor</th><th class="nf-numeric">Valor da nota</th><th>Situação</th><th>Detalhes</th></tr></thead><tbody>
                @foreach (var invoice in FilteredInvoices)
                {
                    <tr data-due="@invoice.DueDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" class="@(_selectedInvoiceId == invoice.Id ? "is-selected" : null)">
                        <td><div class="nf-due-date @DueTone(invoice)"><i class="bi bi-calendar3" aria-hidden="true"></i><strong>@invoice.DueDate.ToString("dd/MM/yyyy", Br)</strong></div><small>@DueLabel(invoice)</small></td>
                        <td><strong class="nf-code">NF @invoice.Number</strong><small>@invoice.ItemCount @(invoice.ItemCount == 1 ? "item" : "itens") · @invoice.Quotation</small></td>
                        <td>@SupplierName(invoice.SupplierId)</td><td class="nf-numeric">@Money(invoice.Value)</td><td><span class="nf-status @DueTone(invoice)"><i class="bi @DueIcon(invoice)" aria-hidden="true"></i>@PaymentLabel(invoice)</span></td>
                        <td><button type="button" class="nf-text-button" aria-label="@($"Ver nota {invoice.Number}")" aria-expanded="@(_selectedInvoiceId == invoice.Id ? "true" : "false")" aria-controls="nf-invoice-detail" @onclick="() => _selectedInvoiceId = invoice.Id">Ver nota <i class="bi bi-arrow-up-right" aria-hidden="true"></i></button></td>
                    </tr>
                }
            </tbody></table></div>
            @if (FilteredInvoices.Count == 0) { <p class="nf-empty">Nenhuma nota da amostra corresponde aos filtros selecionados.</p> }
        </section>
        @if (_invoices.FirstOrDefault(i => i.Id == _selectedInvoiceId) is { } selectedInvoice)
        {
            <section id="nf-invoice-detail" class="nf-card nf-detail" role="region" aria-label="Detalhes da nota fiscal">
                <div class="nf-card-heading"><div><span class="nf-eyebrow">DETALHES DA NOTA · DEMONSTRAÇÃO</span><h3>NF @selectedInvoice.Number · @SupplierName(selectedInvoice.SupplierId)</h3><p>@selectedInvoice.Quotation · @selectedInvoice.PaymentMethod</p></div><button type="button" class="nf-secondary-button" @onclick="ClearInvoiceSelection"><i class="bi bi-x-lg" aria-hidden="true"></i> Fechar detalhes</button></div>
                <div class="nf-detail-grid"><div><span>Valor da nota</span><strong>@Money(selectedInvoice.Value)</strong></div><div><span>Emissão</span><strong>@selectedInvoice.IssueDate.ToString("dd/MM/yyyy", Br)</strong></div><div><span>Recebimento</span><strong>@selectedInvoice.ReceivedDate.ToString("dd/MM/yyyy", Br)</strong></div><div><span>Vencimento</span><strong>@selectedInvoice.DueDate.ToString("dd/MM/yyyy", Br)</strong></div></div>
                <div class="nf-detail-grid"><div><span>Quantidade de itens</span><strong>@selectedInvoice.ItemCount</strong></div><div><span>Responsável pelo recebimento</span><strong>@selectedInvoice.Receiver</strong></div><div><span>Produtos termolábeis</span><strong>@(selectedInvoice.IsThermolabile ? "Sim" : "Não")</strong></div><div><span>Contém compra</span><strong>@(selectedInvoice.ContainsPurchase ? "Sim" : "Não")</strong></div></div>
                <div class="nf-inline-info"><span class="nf-status @DueTone(selectedInvoice)">@PaymentLabel(selectedInvoice)</span>@if (selectedInvoice.PaidDate is { } paidDate) { <span>Pagamento demonstrativo em @paidDate.ToString("dd/MM/yyyy", Br)</span> }</div>
                @if (!string.IsNullOrWhiteSpace(selectedInvoice.AttachmentName)) { <p class="nf-muted"><i class="bi bi-paperclip" aria-hidden="true"></i> Anexo selecionado: @selectedInvoice.AttachmentName · conteúdo não processado.</p> }
                @if (!string.IsNullOrWhiteSpace(selectedInvoice.Notes)) { <p class="nf-notice"><i class="bi bi-chat-left-text" aria-hidden="true"></i>@selectedInvoice.Notes</p> }
                <div class="nf-detail-footer"><p>Dados ilustrativos para avaliação do acompanhamento financeiro.</p>@if (!selectedInvoice.IsPaid && CanEdit) { <button type="button" class="nf-primary-button" @onclick="() => SimulatePayment(selectedInvoice)"><i class="bi bi-check2-circle" aria-hidden="true"></i> Simular pagamento</button> }</div>
            </section>
        }
    </section>

    <section id="nf-panel-1" role="tabpanel" aria-labelledby="nf-tab-1" hidden="@(_activeTab != 1)">
        <div class="nf-section-heading"><div><h2>Cadastro de NF</h2><p>Preencha os dados para demonstrar o recebimento e a inclusão da nota no acompanhamento.</p></div><span class="nf-status nf-neutral">Campos com * são obrigatórios</span></div>
        <EditForm @key="_invoiceForm" Model="_invoiceForm" OnValidSubmit="SimulateInvoiceRegistration" FormName="nf-demonstration-registration">
            <DataAnnotationsValidator />
            <div class="nf-form-layout">
                <section class="nf-card">
                    <div class="nf-card-heading"><div><h3>Dados da nota fiscal</h3><p>Fornecedores e cotações desta tela são fictícios.</p></div><span class="nf-form-step">01</span></div>
                    <fieldset class="nf-fieldset" disabled="@(!CanEdit)">
                        <div class="nf-form-grid">
                            <div class="nf-control"><label for="nf-number">Número da NF *</label><InputText id="nf-number" @bind-Value="_invoiceForm.Number" maxlength="30" placeholder="Ex.: 000250" /><ValidationMessage For="@(() => _invoiceForm.Number)" /></div>
                            <div class="nf-control"><label for="nf-supplier">Fornecedor *</label><InputSelect id="nf-supplier" @bind-Value="_invoiceForm.SupplierId"><option value="">Selecione o fornecedor</option>@foreach (var supplier in Suppliers) { <option value="@supplier.Id">@supplier.Name</option> }</InputSelect><ValidationMessage For="@(() => _invoiceForm.SupplierId)" /></div>
                            <div class="nf-control"><label for="nf-quotation">Cotação *</label><InputSelect id="nf-quotation" @bind-Value="_invoiceForm.Quotation"><option value="">Selecione a cotação</option>@foreach (var quotation in Quotations) { <option>@quotation</option> }</InputSelect><ValidationMessage For="@(() => _invoiceForm.Quotation)" /></div>
                            <div class="nf-control"><label for="nf-value">Valor da nota (R$) *</label><InputNumber id="nf-value" @bind-Value="_invoiceForm.Value" min="0.01" step="0.01" placeholder="0,00" ParsingErrorMessage="Informe um valor numérico válido." /><ValidationMessage For="@(() => _invoiceForm.Value)" /></div>
                            <div class="nf-control"><label for="nf-item-count">Quantidade de itens *</label><InputNumber id="nf-item-count" @bind-Value="_invoiceForm.ItemCount" min="1" step="1" ParsingErrorMessage="Informe uma quantidade inteira válida." /><ValidationMessage For="@(() => _invoiceForm.ItemCount)" /></div>
                            <div class="nf-control"><label for="nf-payment-method">Forma de pagamento *</label><InputSelect id="nf-payment-method" @bind-Value="_invoiceForm.PaymentMethod"><option>Boleto</option><option>Transferência</option><option>Pix</option></InputSelect></div>
                        </div>
                    </fieldset>
                </section>
                <aside class="nf-card nf-form-aside"><div class="nf-aside-icon"><i class="bi bi-receipt-cutoff" aria-hidden="true"></i></div><h3>Do recebimento ao pagamento</h3><p>A nota cadastrada na simulação será apresentada na agenda, respeitando a ordem da data de vencimento.</p><ol><li>Informe fornecedor e cotação.</li><li>Confira valor e datas.</li><li>Simule o cadastro e consulte a nota.</li></ol><span class="nf-status nf-neutral">Sem gravação no banco</span></aside>
                <section class="nf-card">
                    <div class="nf-card-heading"><div><h3>Recebimento e vencimento</h3><p>Identifique o prazo de pagamento e a entrada da nota.</p></div><span class="nf-form-step">02</span></div>
                    <fieldset class="nf-fieldset" disabled="@(!CanEdit)"><div class="nf-form-grid">
                        <div class="nf-control"><label for="nf-issued">Data de emissão *</label><InputDate id="nf-issued" @bind-Value="_invoiceForm.IssueDate" /><ValidationMessage For="@(() => _invoiceForm.IssueDate)" /></div>
                        <div class="nf-control"><label for="nf-received">Data de recebimento *</label><InputDate id="nf-received" @bind-Value="_invoiceForm.ReceivedDate" /><ValidationMessage For="@(() => _invoiceForm.ReceivedDate)" /></div>
                        <div class="nf-control"><label for="nf-due">Data de vencimento *</label><InputDate id="nf-due" @bind-Value="_invoiceForm.DueDate" /><ValidationMessage For="@(() => _invoiceForm.DueDate)" /></div>
                        <div class="nf-control"><label for="nf-receiver">Responsável pelo recebimento</label><InputText id="nf-receiver" @bind-Value="_invoiceForm.Receiver" maxlength="120" placeholder="Nome do responsável" /></div>
                    </div><div class="nf-checks"><label><InputCheckbox @bind-Value="_invoiceForm.IsThermolabile" /> Produtos termolábeis</label><label><InputCheckbox @bind-Value="_invoiceForm.ContainsPurchase" /> Contém compra</label></div></fieldset>
                </section>
                <section class="nf-card nf-form-wide">
                    <div class="nf-card-heading"><div><h3>Anexo e observações</h3><p>Opcional: selecione o documento para visualizar o nome do arquivo na demonstração.</p></div><span class="nf-form-step">03</span></div>
                    <fieldset class="nf-fieldset" disabled="@(!CanEdit)">
                        <label class="nf-upload"><InputFile @key="_attachmentVersion" OnChange="SelectInvoiceFile" accept=".pdf,.xml" aria-label="Selecionar anexo da nota fiscal" /><i class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i><strong>Selecionar documento da NF</strong><span>PDF ou XML · até 10 MB · conteúdo não processado</span></label>
                        @if (_attachmentError is not null) { <p class="nf-error" role="alert">@_attachmentError</p> }
                        @if (_invoiceAttachment is not null) { <div class="nf-file-name"><i class="bi bi-paperclip" aria-hidden="true"></i><span>@_invoiceAttachment</span><button type="button" class="nf-text-button" @onclick="RemoveInvoiceFile">Remover anexo</button></div> }
                        <div class="nf-control"><label for="nf-notes">Observações</label><InputTextArea id="nf-notes" @bind-Value="_invoiceForm.Notes" rows="3" maxlength="500" placeholder="Informações adicionais sobre o recebimento..." /></div>
                    </fieldset>
                </section>
            </div>
            @if (_invoiceError is not null) { <p class="nf-error" role="alert">@_invoiceError</p> }
            <div class="nf-form-actions"><span>O cadastro será adicionado somente aos dados desta demonstração.</span><div><button type="button" class="nf-secondary-button" @onclick="ResetInvoiceForm" disabled="@(!CanEdit)">Limpar formulário</button><button type="submit" class="nf-primary-button" disabled="@(!CanEdit)"><i class="bi bi-plus-circle" aria-hidden="true"></i> Simular cadastro de NF</button></div></div>
        </EditForm>
    </section>

    <section id="nf-panel-2" role="tabpanel" aria-labelledby="nf-tab-2" hidden="@(_activeTab != 2)">
        <div class="nf-section-heading"><div><h2>Pedidos Emergenciais</h2><p>Acompanhe solicitações prioritárias, os prazos necessários e o andamento das aquisições.</p></div>@if (CanEdit) { <button type="button" class="nf-primary-button" aria-expanded="@(_showEmergencyForm ? "true" : "false")" aria-controls="nf-emergency-form" @onclick="() => _showEmergencyForm = !_showEmergencyForm"><i class="bi bi-plus-lg" aria-hidden="true"></i>@(_showEmergencyForm ? "Fechar nova solicitação" : "Nova solicitação demonstrativa")</button> }</div>
        <div class="nf-metrics nf-metrics-three"><article><span><i class="bi bi-lightning-charge" aria-hidden="true"></i> Pedidos em andamento</span><strong>@_requests.Count(r => r.Status != EmergencyStatus.Completed)</strong><small>Solicitações da amostra</small></article><article><span><i class="bi bi-exclamation-triangle nf-red-icon" aria-hidden="true"></i> Prioridade crítica</span><strong>@_requests.Count(r => r.Status != EmergencyStatus.Completed && r.Priority == EmergencyPriority.Critical)</strong><small>Necessitam acompanhamento próximo</small></article><article><span><i class="bi bi-hourglass-split nf-amber-icon" aria-hidden="true"></i> Aguardando aprovação</span><strong>@_requests.Count(r => r.Status == EmergencyStatus.WaitingApproval)</strong><small>Etapa demonstrativa de análise</small></article></div>
        @if (_showEmergencyForm)
        {
            <section id="nf-emergency-form" class="nf-card nf-detail">
                <div class="nf-card-heading"><div><h3>Nova solicitação emergencial</h3><p>Descreva a necessidade para simular a inclusão do pedido no acompanhamento.</p></div></div>
                <EditForm @key="_emergencyForm" Model="_emergencyForm" OnValidSubmit="SimulateEmergencyRequest" FormName="nf-demonstration-emergency">
                    <DataAnnotationsValidator />
                    <fieldset class="nf-fieldset" disabled="@(!CanEdit)"><div class="nf-form-grid">
                        <div class="nf-control"><label for="nf-em-sector">Setor solicitante *</label><InputSelect id="nf-em-sector" @bind-Value="_emergencyForm.Sector"><option value="">Selecione o setor</option><option>UTI adulto</option><option>Centro cirúrgico</option><option>Emergência</option><option>Enfermaria</option></InputSelect><ValidationMessage For="@(() => _emergencyForm.Sector)" /></div>
                        <div class="nf-control"><label for="nf-em-item">Item solicitado *</label><InputSelect id="nf-em-item" @bind-Value="_emergencyForm.ItemCode"><option value="">Selecione o item</option>@foreach (var item in EmergencyItems) { <option value="@item.Code">@item.Code · @item.Description</option> }</InputSelect><ValidationMessage For="@(() => _emergencyForm.ItemCode)" /></div>
                        <div class="nf-control"><label for="nf-em-quantity">Quantidade (unidades) *</label><InputNumber id="nf-em-quantity" @bind-Value="_emergencyForm.Quantity" min="1" step="1" ParsingErrorMessage="Informe uma quantidade inteira válida." /><ValidationMessage For="@(() => _emergencyForm.Quantity)" /></div>
                        <div class="nf-control"><label for="nf-em-deadline">Necessário até *</label><InputDate id="nf-em-deadline" @bind-Value="_emergencyForm.Deadline" min="@ReferenceDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" /><ValidationMessage For="@(() => _emergencyForm.Deadline)" /></div>
                        <div class="nf-control"><label for="nf-em-priority">Prioridade *</label><InputSelect id="nf-em-priority" @bind-Value="_emergencyForm.Priority">@foreach (var priority in Enum.GetValues<EmergencyPriority>()) { <option value="@priority">@PriorityLabel(priority)</option> }</InputSelect></div>
                        <div class="nf-control nf-span-two"><label for="nf-em-reason">Justificativa *</label><InputTextArea id="nf-em-reason" @bind-Value="_emergencyForm.Reason" rows="3" maxlength="500" placeholder="Descreva a necessidade e o contexto do setor..." /><ValidationMessage For="@(() => _emergencyForm.Reason)" /></div>
                    </div></fieldset>
                    <div class="nf-form-actions"><span>A solicitação não gera compra, aprovação ou comunicação externa.</span><div><button type="button" class="nf-secondary-button" @onclick="() => _showEmergencyForm = false">Cancelar</button><button type="submit" class="nf-primary-button" disabled="@(!CanEdit)">Simular solicitação</button></div></div>
                </EditForm>
            </section>
        }
        <section class="nf-card">
            <div class="nf-card-heading"><div><h3>Acompanhamento dos pedidos</h3><p>Prioridades críticas aparecem primeiro, seguidas pelo prazo de necessidade.</p></div><span class="nf-status nf-neutral" aria-live="polite">@FilteredRequests.Count de @_requests.Count pedidos</span></div>
            <div class="nf-filters"><label class="nf-control nf-grow"><span>Buscar pedido, item ou setor</span><input type="search" placeholder="Ex.: PE-2026-001, noradrenalina, UTI" @bind="_requestSearch" @bind:event="oninput" @bind:after="ClearRequestSelection" /></label><label class="nf-control"><span>Prioridade</span><select aria-label="Filtrar pedidos por prioridade" @bind="_priorityFilter" @bind:after="ClearRequestSelection"><option value="">Todas</option>@foreach (var priority in Enum.GetValues<EmergencyPriority>()) { <option value="@priority">@PriorityLabel(priority)</option> }</select></label><label class="nf-control"><span>Andamento</span><select aria-label="Filtrar pedidos por andamento" @bind="_requestStatus" @bind:after="ClearRequestSelection"><option value="active">Em andamento</option><option value="all">Todos</option>@foreach (var status in Enum.GetValues<EmergencyStatus>()) { <option value="@status">@EmergencyStatusLabel(status)</option> }</select></label></div>
            @if (HasRequestFilters) { <div class="nf-filter-summary"><span>Filtros aplicados ao acompanhamento</span><button type="button" class="nf-text-button" @onclick="ResetRequestFilters">Limpar filtros</button></div> }
            <div class="nf-table-scroll"><table class="nf-table nf-request-table"><thead><tr><th>Pedido / setor</th><th>Item</th><th class="nf-numeric">Quantidade</th><th>Necessário até</th><th>Prioridade</th><th>Andamento</th><th>Detalhes</th></tr></thead><tbody>
                @foreach (var request in FilteredRequests)
                {
                    <tr class="@(_selectedRequestId == request.Id ? "is-selected" : null)"><td><strong class="nf-code">@request.Code</strong><small>@request.Sector</small></td><td>@request.ItemDescription<small>@request.ItemCode</small></td><td class="nf-numeric">@request.Quantity.ToString("N0", Br) un.</td><td class="nf-nowrap">@request.Deadline.ToString("dd/MM/yyyy", Br)</td><td><span class="nf-status @PriorityTone(request.Priority)"><i class="bi bi-flag" aria-hidden="true"></i>@PriorityLabel(request.Priority)</span></td><td><span class="nf-status nf-neutral">@EmergencyStatusLabel(request.Status)</span></td><td><button type="button" class="nf-text-button" aria-label="@($"Ver pedido {request.Code}")" aria-expanded="@(_selectedRequestId == request.Id ? "true" : "false")" aria-controls="nf-request-detail" @onclick="() => _selectedRequestId = request.Id">Ver pedido <i class="bi bi-arrow-up-right" aria-hidden="true"></i></button></td></tr>
                }
            </tbody></table></div>
            @if (FilteredRequests.Count == 0) { <p class="nf-empty">Nenhum pedido fictício corresponde aos filtros selecionados.</p> }
        </section>
        @if (_requests.FirstOrDefault(r => r.Id == _selectedRequestId) is { } selectedRequest)
        {
            <section id="nf-request-detail" class="nf-card nf-detail" role="region" aria-label="Detalhes do pedido emergencial"><div class="nf-card-heading"><div><span class="nf-eyebrow">SOLICITAÇÃO EMERGENCIAL · DEMONSTRAÇÃO</span><h3>@selectedRequest.Code · @selectedRequest.ItemDescription</h3><p>@selectedRequest.Sector · Criado em @selectedRequest.CreatedAt.ToString("dd/MM/yyyy", Br)</p></div><button type="button" class="nf-secondary-button" @onclick="ClearRequestSelection"><i class="bi bi-x-lg" aria-hidden="true"></i> Fechar detalhes</button></div><div class="nf-detail-grid"><div><span>Quantidade solicitada</span><strong>@selectedRequest.Quantity.ToString("N0", Br) unidades</strong></div><div><span>Prazo de necessidade</span><strong>@selectedRequest.Deadline.ToString("dd/MM/yyyy", Br)</strong></div><div><span>Prioridade</span><strong>@PriorityLabel(selectedRequest.Priority)</strong></div><div><span>Andamento</span><strong>@EmergencyStatusLabel(selectedRequest.Status)</strong></div></div><div class="nf-context-box"><h4>Justificativa da solicitação</h4><p>@selectedRequest.Reason</p></div><div class="nf-detail-footer"><p>Solicitação ilustrativa; não representa autorização de compra.</p>@if (selectedRequest.InvoiceId is int linkedInvoiceId) { <button type="button" class="nf-secondary-button" @onclick="() => OpenInvoice(linkedInvoiceId)">Ver NF vinculada <i class="bi bi-arrow-up-right" aria-hidden="true"></i></button> }</div></section>
        }
    </section>
    <footer class="nf-footer"><i class="bi bi-info-circle" aria-hidden="true"></i> Prévia visual para avaliação. Dados, documentos e confirmações desta tela são demonstrativos.</footer>
</div>

<style>
