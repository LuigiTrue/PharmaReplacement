@using System.ComponentModel.DataAnnotations
@implements IDialogContentComponent
@implements IDisposable
@inject IQuotationService QuotationService
@inject ILogger<QuotationRegistrationDialog> Logger

<FluentDialogHeader ShowDismiss="false" Style="padding-bottom: 1rem;">
    <div class="registration-header">
        <div class="registration-heading">
            <span class="registration-icon" aria-hidden="true"><i class="bi bi-file-earmark-text"></i></span>
            <div>
                <h2>Cadastrar cotação</h2>
                <p>Identifique a cotação de compras vinculada à nota fiscal.</p>
            </div>
        </div>
        <button type="button" class="registration-close" title="Fechar" aria-label="Fechar cadastro de cotação"
                disabled="@_saving" @onclick="CancelAsync">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
    </div>
</FluentDialogHeader>

<FluentDialogBody Style="min-height: 0; overflow: hidden; display: flex; flex-direction: column;">
    <div class="quotation-registration" aria-busy="@_saving">
        <EditForm class="registration-form" Model="_form" OnValidSubmit="SaveAsync" FormName="following-quotation-registration" novalidate>
            <DataAnnotationsValidator />
            <div class="registration-content">
                @if (_errorMessage is not null)
                {
                    <p class="registration-error" role="alert">@_errorMessage</p>
                }
                <ValidationSummary />
                <fieldset class="registration-fields" disabled="@_saving">
                    <div class="registration-field">
                        <label for="quotation-registration-number">Número da cotação <span aria-hidden="true">*</span></label>
                        <InputText id="quotation-registration-number" @bind-Value="_form.QuotationNumber" maxlength="50" aria-required="true" aria-describedby="quotation-registration-number-hint" placeholder="Informe o número da cotação" />
                        <small id="quotation-registration-number-hint">Use o identificador da cotação de compras. Até 50 caracteres.</small>
                        <ValidationMessage For="@(() => _form.QuotationNumber)" />
                    </div>
                </fieldset>
            </div>
            <div class="registration-actions">
                <small>* Campo obrigatório</small>
                <button type="button" class="btn registration-cancel" disabled="@_saving" @onclick="CancelAsync">Cancelar</button>
                <button type="submit" class="btn btn-primary" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    }
                    @(_saving ? "Cadastrando..." : "Cadastrar cotação")
                </button>
            </div>
        </EditForm>
    </div>
</FluentDialogBody>

@code {
    [CascadingParameter] public FluentDialog Dialog { get; set; } = null!;

    private readonly QuotationForm _form = new();
    private readonly CancellationTokenSource _lifetime = new();
    private bool _saving;
    private bool _disposed;
    private Quotation? _saved;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        Dialog.Instance.Parameters.ValidateDialogAsync = () => Task.FromResult(!_saving || _saved is not null);
    }

    private async Task SaveAsync()
    {
        if (_saving || _disposed || _saved is not null)
            return;

        _saving = true;
        _errorMessage = null;
        var cancellationToken = _lifetime.Token;
        try
        {
            var quotation = await QuotationService.CreateQuotationAsync(new Quotation
            {
                QuotationNumber = _form.QuotationNumber.Trim()
            }, cancellationToken);
            if (_disposed)
                return;

            _saved = quotation;
            await Dialog.CloseAsync(quotation);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // O diálogo foi descartado; não há interface ativa para notificar.
        }
        catch (ArgumentException) when (!_disposed)
        {
            _errorMessage = "Confira o número informado antes de cadastrar a cotação.";
        }
        catch (InvalidOperationException) when (!_disposed)
        {
            _errorMessage = "Não foi possível cadastrar a cotação. Verifique se esse número já está cadastrado.";
        }
        catch (Exception exception)
        {
            Logger.LogError("Falha no cadastro de cotação. Tipo de erro: {ErrorType}", exception.GetType().Name);
            if (!_disposed)
                _errorMessage = "Não foi possível cadastrar a cotação. Tente novamente. Os dados foram mantidos.";
        }
        finally
        {
            if (!_disposed)
                _saving = false;
        }
    }

    private async Task CancelAsync()
    {
        if (!_saving && !_disposed)
            await Dialog.CancelAsync();
    }

    public void Dispose()
    {
        if (_disposed)
            return;

        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    public sealed class QuotationForm
    {
        [Required(ErrorMessage = "Informe o número da cotação.")]
        [StringLength(50, ErrorMessage = "O número da cotação deve ter até 50 caracteres.")]
        public string QuotationNumber { get; set; } = string.Empty;
    }
}
