@page "/"
@page "/Login"
@layout LoginLayout
@using System.ComponentModel.DataAnnotations
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<div class="login-container">
    <div class="login-shell">
        <div class="login-visual" aria-hidden="true">
            <img src="/img/pharma_login_theme.jpg" alt="" />
            <div class="login-visual-overlay">
                <span class="login-visual-badge">RepyPharma</span>
                <h2>Reposição rápida e objetiva</h2>
                <p>Para facilitar e viabilizar a disponibilidade de itens na farmácia central.</p>
            </div>
        </div>

        <div class="login-card">
            <div class="login-header">
                <h1>Bem-vindo</h1>
                <p>Entre com suas credenciais para continuar</p>
            </div>

            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" class="login-form">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="username">Usuário</label>
                    <InputText id="username" class="form-control" @bind-Value="loginModel.Username" placeholder="Digite seu usuário" />
                    <ValidationMessage For="@(() => loginModel.Username)" />
                </div>

                <div class="form-group">
                    <label for="password">Senha</label>
                    <div class="password-field">
                        <InputText id="password" type="@PasswordInputType" class="form-control password-control" @bind-Value="loginModel.Password" placeholder="••••••••" />
                        <button type="button"
                                class="password-toggle"
                                title="@PasswordToggleTitle"
                                aria-label="@PasswordToggleTitle"
                                @onclick="TogglePasswordVisibility">
                            <i class="bi @PasswordToggleIcon" aria-hidden="true"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert-error">@errorMessage</div>
                }

                <button type="submit" class="btn-login" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner"></span>
                        <span>Entrando...</span>
                    }
                    else
                    {
                        <span>Entrar</span>
                    }
                </button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private bool isLoading = false;
    private bool showPassword = false;
    private string? errorMessage;
    private string PasswordInputType => showPassword ? "text" : "password";
    private string PasswordToggleIcon => showPassword ? "bi-eye-slash" : "bi-eye";
    private string PasswordToggleTitle => showPassword ? "Ocultar senha" : "Mostrar senha";

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        var result = await AuthService.LoginAsync(loginModel.Username, loginModel.Password, loginModel.RememberMe);

        isLoading = false;

        if (!result.Succeeded)
        {
            errorMessage = result.ErrorMessage;
            return;
        }

        Navigation.NavigateTo(GetReturnUrl(), replace: true);
    }

    private string GetReturnUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');

        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2 && pair[0] == "returnUrl")
            {
                var returnUrl = Uri.UnescapeDataString(pair[1]);
                return string.IsNullOrWhiteSpace(returnUrl) || returnUrl.StartsWith("Login", StringComparison.OrdinalIgnoreCase)
                    ? "/Home"
                    : $"/{returnUrl.TrimStart('/')}";
            }
        }

        return "/Home";
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Informe o usuário")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe a senha")]
        [MinLength(6, ErrorMessage = "A senha deve ter ao menos 6 caracteres")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
