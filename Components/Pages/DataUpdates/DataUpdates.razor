@page "/DataUpdates"
@page "/DateUpdates"
@attribute [Authorize(Roles = "Admin,Farmacia,Almoxarifado,Consulta")]
@inject IAuthService AuthService
@inject RepyPharma.Services.Import.Interfaces.IConsumptionImportService ConsumptionService
@inject ILogger<DataUpdates> Logger
@implements IAsyncDisposable

<PageTitle>Atualização de Dados | RepyPharma</PageTitle>

<div class="data-updates">
    <header class="du-header">
        <div><div class="du-eyebrow">GESTÃO HOSPITALAR · ATUALIZAÇÃO DE DADOS</div><h1><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Atualização de Dados</h1><p>Organize os arquivos de consumo e mantenha o estoque em dia.</p></div>
        <div class="du-header-context"><span class="du-demo-badge"><i class="bi bi-circle-fill" aria-hidden="true"></i> Atualização de dados</span><span class="du-muted">Referência: @_today.ToString("dd/MM/yyyy", Br) · horário de Brasília</span></div>
    </header>
    <p class="du-demo-note"><i class="bi bi-info-circle" aria-hidden="true"></i> Consumo: selecione a competência e anexe os relatórios no painel de nova atualização. Estoque atual: espelho de estoque em PDF do Soul MV.</p>

    <nav class="du-tabs" role="tablist" aria-label="Tipos de atualização de dados">
        @for (var index = 0; index < TabNames.Length; index++)
        {
            var tab = index;
            <button type="button" id="@($"du-tab-{tab}")" role="tab" aria-controls="@($"du-panel-{tab}")" aria-selected="@(tab == _activeTab ? "true" : "false")" class="@(_activeTab == tab ? "is-active" : null)" @onclick="() => ChangeTab(tab)"><i class="bi @TabIcons[tab]" aria-hidden="true"></i>@TabNames[tab]</button>
        }
    </nav>
    @if (!CanImport)
    {
        <p class="du-notice"><i class="bi bi-eye" aria-hidden="true"></i> Seu perfil permite consultar as atualizações e o histórico. O envio de arquivos está disponível para perfis com permissão de atualização.</p>
    }
    @if (_message is not null)
    {
        <div class="du-feedback" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i><span>@_message</span><button type="button" class="du-icon-button" aria-label="Fechar mensagem" @onclick="() => _message = null"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
    }
    @if (_attachment is { } attachment && CanImport)
    {
        <CsvAttachment @key="attachment" Kind="attachment.Kind" ReferenceDate="attachment.ReferenceDate" Today="_today"
                       OnImported="CompleteConsumption" OnStockImported="CompleteStock" OnCancel="CloseAttachment" />
    }
    <section id="du-panel-0" role="tabpanel" aria-labelledby="du-tab-0" hidden="@(_activeTab != 0)">
        <ConsumptionImport Today="_today" FirstYear="_firstYear" Imports="_imports" CanImport="CanImport" OnAttach="OpenConsumptionAttachment" OnImported="CompleteConsumption" OnViewImport="ViewImport" />
    </section>
    <section id="du-panel-1" role="tabpanel" aria-labelledby="du-tab-1" hidden="@(_activeTab != 1)">
        <StockImport Today="_today" Imports="_imports" CanImport="CanImport" OnAttach="OpenStockAttachment" OnViewImport="ViewImport" />
    </section>
    <section id="du-panel-2" role="tabpanel" aria-labelledby="du-tab-2" hidden="@(_activeTab != 2)">
        <ImportHistory @key="_historyVersion" Imports="_imports" SelectedId="_selectedImportId" />
    </section>
    <footer class="du-footer"><i class="bi bi-calendar2-check" aria-hidden="true"></i> Os meses são disponibilizados automaticamente conforme o calendário. Competências já importadas podem ser atualizadas por um novo arquivo válido.</footer>
</div>

@code {
    [Inject] public TimeProvider Clock { get; set; } = TimeProvider.System;
    [SupplyParameterFromQuery(Name = "tab")] public string? InitialTab { get; set; }
    public static readonly CultureInfo Br = CultureInfo.GetCultureInfo("pt-BR");
    private static readonly TimeZoneInfo BrasiliaZone = TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo");
    private static readonly string[] TabNames = ["Consumo", "Estoque atual", "Histórico de importações"];
    private static readonly string[] TabIcons = ["bi-calendar3", "bi-box-seam", "bi-clock-history"];
    private readonly List<ImportRecord> _imports = [];
    private readonly CancellationTokenSource _lifetime = new();
    private DateOnly _today;
    private int _firstYear, _activeTab, _historyVersion;
    private string? _lastInitialTab, _message;
    private Guid? _selectedImportId;
    private AttachmentRequest? _attachment;
    private Task? _calendarTask;
    private bool _disposed;
    private bool CanImport => AuthService.IsInRole("Admin") || AuthService.IsInRole("Farmacia") || AuthService.IsInRole("Almoxarifado");

    public enum ImportKind { Consumption, Stock }
    public sealed record AttachmentRequest(ImportKind Kind, DateOnly ReferenceDate);
    public sealed record SelectedCsv(string Name, long Size);
    public sealed record ImportRecord(Guid Id, ImportKind Kind, DateOnly ReferenceDate, string FileName,
        DateTimeOffset RegisteredAt, ConsumptionOperationStatus Status, string Detail, DateOnly? RecordedThrough = null);
    public static string KindLabel(ImportKind kind) => kind == ImportKind.Consumption ? "Consumo" : "Estoque atual";
    public static string StatusLabel(ConsumptionOperationStatus status) => status == ConsumptionOperationStatus.Completed ? "Concluída" : "Falha";
    public static string StatusClass(ConsumptionOperationStatus status) => status == ConsumptionOperationStatus.Completed ? "du-status du-success" : "du-status du-error";
    public static string PeriodLabel(ImportRecord record) => record.Kind == ImportKind.Consumption ? record.ReferenceDate.ToString("MMMM/yyyy", Br) : record.ReferenceDate.ToString("dd/MM/yyyy", Br);

    protected override async Task OnInitializedAsync()
    {
        _today = CalendarDate();
        _firstYear = _today.Year - 1;
        AuthService.OnChange += HandleAuthChanged;
        try
        {
            var imports = await ConsumptionService.GetImportsAsync(_lifetime.Token);
            _imports.AddRange(imports.Select(ToImportRecord));
            if (_imports.Count > 0) _firstYear = Math.Min(_firstYear, _imports.Min(i => i.ReferenceDate.Year));
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Não foi possível carregar o histórico de consumo.");
            _message = "Não foi possível carregar o histórico. Verifique a conexão e as migrations do banco.";
        }
    }
    private static ImportRecord ToImportRecord(ConsumptionImportResultDto result) => new(result.ImportId,
        ImportKind.Consumption, result.ConsumptionPeriod!.StartDate, result.SourceFileName,
        TimeZoneInfo.ConvertTime(result.CompletedAt!.Value, BrasiliaZone), result.Status,
        $"Consumos gravados até {result.ConsumptionPeriod.EndDate:dd/MM/yyyy}. Os valores podem ser atualizados por outro relatório válido.",
        result.ConsumptionPeriod.EndDate);
    private void CompleteConsumption(ConsumptionImportResultDto result)
    {
        _imports.Insert(0, ToImportRecord(result));
        _attachment = null;
        _historyVersion++;
        _message = "Consumo importado com sucesso.";
        if (result.Issues.Count > 0) _message += " Avisos: " + string.Join(" ", result.Issues.Take(5)
            .Select(i => (i.ItemCode is null ? "" : $"Produto {i.ItemCode}: ") + i.Message));
    }
    protected override void OnParametersSet()
    {
        if (InitialTab == _lastInitialTab) return;
        _lastInitialTab = InitialTab;
        ChangeTab(InitialTab switch { "stock" => 1, "history" => 2, _ => 0 });
    }
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _calendarTask = WatchCalendarAsync(_lifetime.Token);
        return Task.CompletedTask;
    }
    private DateOnly CalendarDate() => DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), BrasiliaZone).DateTime);
    private async Task WatchCalendarAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1), Clock);
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    var today = CalendarDate();
                    if (_disposed || today == _today) return;
                    _today = today;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (ObjectDisposedException) when (cancellationToken.IsCancellationRequested) { }
    }
    private void HandleAuthChanged()
    {
        if (!_disposed) _ = InvokeAsync(() => { if (!CanImport) _attachment = null; StateHasChanged(); });
    }
    private void ChangeTab(int tab) { _activeTab = tab; _attachment = null; _message = null; }
    private void CloseAttachment() => _attachment = null;
    private void OpenConsumptionAttachment(DateOnly period)
    {
        var currentMonth = new DateOnly(_today.Year, _today.Month, 1);
        if (!CanImport || period > currentMonth || period.Year < _firstYear) return;
        _message = null;
        _attachment = new(ImportKind.Consumption, period);
    }
    private void OpenStockAttachment()
    {
        if (!CanImport) return;
        _message = null;
        _attachment = new(ImportKind.Stock, _today);
    }
    private void CompleteStock(string fileName)
    {
        _imports.Insert(0, new(Guid.NewGuid(), ImportKind.Stock, CalendarDate(), fileName,
            TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), BrasiliaZone), ConsumptionOperationStatus.Completed,
            "Espelho de estoque PDF validado e gravado pelo importador existente. As informações deste arquivo permanecem nesta sessão; os dados do estoque foram persistidos."));
        if (_attachment?.Kind == ImportKind.Stock) _attachment = null;
        _historyVersion++;
        _message = "Estoque atualizado com sucesso a partir do espelho PDF.";
    }
    private void ViewImport(Guid id) { ChangeTab(2); _selectedImportId = id; _historyVersion++; }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        AuthService.OnChange -= HandleAuthChanged;
        _lifetime.Cancel();
        if (_calendarTask is not null) await _calendarTask;
        _lifetime.Dispose();
    }
}
