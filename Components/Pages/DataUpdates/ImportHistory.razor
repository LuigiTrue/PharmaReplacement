<div class="du-section-heading"><div><h2>Histórico de importações</h2><p>Acompanhe as importações de consumo em CSV e as atualizações de estoque em PDF.</p></div><span class="du-status du-neutral">@FilteredImports.Count registros</span></div>
<section class="du-card">
    <div class="du-filters du-history-filters">
        <label class="du-control du-grow"><span>Buscar arquivo ou período</span><input type="search" placeholder="Ex.: consumo, estoque, setembro/2026" @bind="_search" @bind:event="oninput" /></label>
        <label class="du-control"><span>Tipo de atualização</span><select aria-label="Filtrar histórico por tipo" @bind="_kind"><option value="">Todos os tipos</option><option value="Consumption">Consumo</option><option value="Stock">Estoque atual</option></select></label>
        <label class="du-control"><span>Situação</span><select aria-label="Filtrar histórico por situação" @bind="_status"><option value="">Todas</option><option value="Completed">Concluída</option><option value="Failed">Falha</option></select></label>
    </div>
    @if (HasFilters) { <div class="du-filter-summary"><span>@FilteredImports.Count de @Imports.Count registros</span><button type="button" class="du-text-button" @onclick="ClearFilters">Limpar filtros</button></div> }
    <div class="du-table-scroll"><table class="du-table"><thead><tr><th>Registrado em</th><th>Atualização</th><th>Referência</th><th>Arquivo</th><th>Situação</th><th>Detalhes</th></tr></thead><tbody>
        @foreach (var entry in FilteredImports)
        {
            <tr class="@(_selectedId == entry.Id ? "is-selected" : null)"><td class="du-nowrap">@entry.RegisteredAt.ToString("dd/MM/yyyy", Br)<small>@entry.RegisteredAt.ToString("HH:mm", Br) · Brasília</small></td><td>@KindLabel(entry.Kind)</td><td class="du-nowrap">@PeriodLabel(entry)</td><td class="du-filename">@entry.FileName</td><td><span class="@StatusClass(entry.Status)"><i class="bi @(entry.Status == ConsumptionOperationStatus.Completed ? "bi-check-circle" : "bi-exclamation-circle")" aria-hidden="true"></i>@StatusLabel(entry.Status)</span></td><td><button type="button" class="du-text-button" aria-label="@($"Ver detalhes de {entry.FileName}")" aria-controls="du-import-detail" aria-expanded="@(_selectedId == entry.Id ? "true" : "false")" @onclick="() => _selectedId = entry.Id">Ver detalhes <i class="bi bi-arrow-up-right" aria-hidden="true"></i></button></td></tr>
        }
    </tbody></table></div>
    @if (FilteredImports.Count == 0) { <p class="du-empty">Nenhuma importação corresponde aos filtros selecionados.</p> }
</section>
@if (Imports.FirstOrDefault(i => i.Id == _selectedId) is { } selected)
{
    <section id="du-import-detail" class="du-card du-import-detail" role="region" aria-label="Detalhes da importação">
        <div class="du-card-heading"><div><span class="du-eyebrow">DETALHES DA ATUALIZAÇÃO</span><h3>@selected.FileName</h3><p>@KindLabel(selected.Kind) · @PeriodLabel(selected)</p></div><button type="button" class="du-secondary-button" @onclick="() => _selectedId = null"><i class="bi bi-x-lg" aria-hidden="true"></i> Fechar detalhes</button></div>
        <div class="du-detail-grid"><div><span>Situação</span><strong>@StatusLabel(selected.Status)</strong></div><div><span>Registrado em</span><strong>@selected.RegisteredAt.ToString("dd/MM/yyyy HH:mm", Br)</strong></div></div>
        <p class="du-notice @(selected.Status == ConsumptionOperationStatus.Failed ? "du-notice-error" : null)"><i class="bi @(selected.Status == ConsumptionOperationStatus.Failed ? "bi-exclamation-triangle" : "bi-info-circle")" aria-hidden="true"></i>@selected.Detail</p>
        <p class="du-muted">@(selected.Kind == ImportKind.Consumption ? "O histórico de consumo permanece disponível após recarregar a página." : "Os dados do estoque foram gravados. As informações do arquivo PDF neste histórico estão disponíveis nesta sessão.")</p>
    </section>
}

@code {
    [Parameter] public IReadOnlyList<ImportRecord> Imports { get; set; } = [];
    [Parameter] public Guid? SelectedId { get; set; }
    private Guid? _previousSelectedId, _selectedId;
    private string _search = "", _kind = "", _status = "";
    private bool HasFilters => _search.Length > 0 || _kind.Length > 0 || _status.Length > 0;
    private IReadOnlyList<ImportRecord> FilteredImports => Imports.Where(i =>
        (_kind.Length == 0 || i.Kind.ToString() == _kind) && (_status.Length == 0 || i.Status.ToString() == _status) &&
        (string.IsNullOrWhiteSpace(_search) || Br.CompareInfo.IndexOf(i.FileName + " " + PeriodLabel(i) + " " + KindLabel(i.Kind), _search.Trim(), CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0))
        .OrderByDescending(i => i.RegisteredAt).ThenBy(i => i.FileName).ToArray();
    private void ClearFilters() => _search = _kind = _status = "";
    protected override void OnParametersSet()
    {
        if (SelectedId == _previousSelectedId) return;
        _previousSelectedId = SelectedId;
        _selectedId = SelectedId;
        ClearFilters();
    }
}
