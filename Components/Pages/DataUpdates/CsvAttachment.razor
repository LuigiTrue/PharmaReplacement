@inject RepyPharma.Services.Import.Interfaces.IConsumptionImportService ConsumptionService
@inject ILogger<CsvAttachment> Logger
@implements IDisposable

@if (Kind == ImportKind.Stock)
{
    <AttachmentPanel Kind="Kind" ReferenceDate="ReferenceDate" OnCancel="OnCancel"
                     Description="Confira a referência e selecione o PDF do Relatório de Conferência dos Lotes."
                     Notice="Anexe o espelho de estoque do Soul MV, em PDF, com até 10 MB. Gere o relatório dos estoques 996, 997, 999 e 1059."
                     ActionHint="Selecionar um PDF válido inicia a atualização do estoque.">
        <Files><InputFileComponent UploadId="data-updates-stock-pdf" UseAttachmentLayout="true" SelectionAnchorId="data-updates-stock-pdf-action"
                                   Title="Posição de Estoque" OnImported="OnStockImported" /></Files>
        <Actions><button type="button" id="data-updates-stock-pdf-action" class="du-primary-button"><i class="bi bi-paperclip" aria-hidden="true"></i>Selecionar PDF</button></Actions>
    </AttachmentPanel>
}
else if (ReferenceDate < new DateOnly(Today.Year, Today.Month, 1))
{
    <MonthlyConsumptionReports ReferenceMonth="ReferenceDate" OnImported="OnImported" OnCancel="OnCancel" />
}
else
{
    <AttachmentPanel Kind="Kind" ReferenceDate="ReferenceDate" Busy="_processing" HasFiles="@(_selected is not null)" OnCancel="OnCancel"
                     Description="Selecione os relatórios correspondentes à competência."
                     Notice="@($"O consumo diário deve apresentar todos os dias de 01 a {RequiredThrough.Day:00} para cada produto. A competência é definida pelo card selecionado.")"
                     ActionHint="Confira os arquivos e a competência antes de atualizar.">
        <Files>
            <div data-report="daily">
                <h3>Consumo diário <span class="du-status du-neutral">Obrigatório</span></h3>
                <label class="du-upload-zone">
                    <InputFile @key="_inputVersion" OnChange="SelectFile" accept=".csv,text/csv" class="du-file-input" disabled="@_processing" aria-label="Consumo diário" aria-required="true" />
                    <span class="du-upload-icon"><i class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i></span><strong>@(_selected is null ? "Clique para selecionar consumo diário" : "Clique para escolher outro arquivo")</strong><span>CSV · R_CONS_DIARIO · um arquivo · até 10 MB</span>
                </label>
                @if (_selected is { } file)
                {
                    <div class="du-selected-file"><i class="bi bi-filetype-csv" aria-hidden="true"></i><div><strong>@file.Name</strong><small>@FormatSize(file.Size) · Arquivo selecionado</small></div><button type="button" class="du-text-button" disabled="@_processing" @onclick="RemoveFile">Remover</button></div>
                }
            </div>
            @foreach (var position in new[] { true, false })
            {
                var title = position ? "Posição de Estoque" : "Consolidação Mensal de Estoque";
                var selected = position ? _positionFile : _monthlyFile;
                <div data-report="@(position ? "position" : "monthly")">
                    <h3>@title <span class="du-status du-neutral">@(position ? "Quando aplicável" : "Obrigatório")</span></h3>
                    <label class="du-upload-zone">
                        <InputFile @key="(position ? _positionVersion : _monthlyVersion)" OnChange="args => SelectAdditionalFile(args, position)" accept="@(position ? ".csv,.pdf,text/csv,application/pdf" : ".csv,text/csv")" class="du-file-input" disabled="@_processing" aria-label="@title" aria-required="@(position ? "false" : "true")" />
                        <span class="du-upload-icon"><i class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i></span><strong>@(selected is null ? $"Clique para selecionar {title.ToLower(Br)}" : "Clique para escolher outro arquivo")</strong><span>@(position ? "CSV ou PDF" : "CSV") · um arquivo · até 10 MB</span>
                    </label>
                    @if (selected is not null)
                    {
                        <div class="du-selected-file"><i class="bi bi-file-earmark-check" aria-hidden="true"></i><div><strong>@selected.Name</strong><small>@FormatSize(selected.Size) · Arquivo selecionado</small></div><button type="button" class="du-text-button" disabled="@_processing" @onclick="() => RemoveAdditionalFile(position)">Remover</button></div>
                    }
                </div>
            }
            @if (_error is not null) { <p class="du-file-error" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i>@_error</p> }
        </Files>
        <Actions><button type="button" class="du-primary-button" disabled="@(_selected is null || _monthlyFile is null || _error is not null || _processing)" @onclick="ConfirmAsync"><i class="bi bi-check2-circle" aria-hidden="true"></i>@(_processing ? "Importando…" : "Importar CSV")</button></Actions>
    </AttachmentPanel>
}

@code {
    public const long MaximumFileSize = 10 * 1024 * 1024;
    [Parameter] public ImportKind Kind { get; set; }
    [Parameter] public DateOnly ReferenceDate { get; set; }
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public EventCallback<string> OnStockImported { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<ConsumptionImportResultDto> OnImported { get; set; }
    private SelectedCsv? _selected;
    private IBrowserFile? _browserFile;
    private string? _error;
    private bool _processing;
    private int _inputVersion;
    private IBrowserFile? _positionFile, _monthlyFile;
    private int _positionVersion, _monthlyVersion;
    private readonly CancellationTokenSource _lifetime = new();
    private DateOnly RequiredThrough => ReferenceDate.Year == Today.Year && ReferenceDate.Month == Today.Month
        ? Today : ReferenceDate.AddDays(DateTime.DaysInMonth(ReferenceDate.Year, ReferenceDate.Month) - 1);
    private void SelectFile(InputFileChangeEventArgs args)
    {
        if (_processing) return;
        _selected = null;
        _browserFile = null;
        _error = null;
        if (args.FileCount != 1) { _error = "Selecione apenas um arquivo CSV por atualização."; return; }
        var file = args.File;
        if (!string.Equals(Path.GetExtension(file.Name), ".csv", StringComparison.OrdinalIgnoreCase)) { _error = "Selecione um arquivo com extensão .csv."; return; }
        if (file.Size == 0) { _error = "O arquivo está vazio."; return; }
        if (file.Size > MaximumFileSize) { _error = "O arquivo excede o limite de 10 MB."; return; }
        _selected = new(file.Name, file.Size);
        _browserFile = file;
    }
    private void RemoveFile() { _selected = null; _browserFile = null; _error = null; _inputVersion++; }
    private void SelectAdditionalFile(InputFileChangeEventArgs args, bool position)
    {
        if (_processing) return;
        _error = null;
        if (position) _positionFile = null; else _monthlyFile = null;
        if (args.FileCount != 1) { _error = "Selecione apenas um arquivo por relatório."; return; }
        var file = args.File;
        var extension = Path.GetExtension(file.Name);
        if (!(string.Equals(extension, ".csv", StringComparison.OrdinalIgnoreCase) || position && string.Equals(extension, ".pdf", StringComparison.OrdinalIgnoreCase))
            || file.Size <= 0 || file.Size > MaximumFileSize || file.Name.Length > 255)
        { _error = position ? "Selecione uma posição de estoque em CSV ou PDF, não vazia e de até 10 MB." : "Selecione uma consolidação mensal em CSV, não vazia e de até 10 MB."; return; }
        if (position) _positionFile = file; else _monthlyFile = file;
    }
    private void RemoveAdditionalFile(bool position)
    {
        if (_processing) return;
        if (position) { _positionFile = null; _positionVersion++; } else { _monthlyFile = null; _monthlyVersion++; }
        _error = null;
    }
    private async Task ConfirmAsync()
    {
        if (_selected is null || _processing) return;
        if (_browserFile is not { } file) return;
        _processing = true;
        _error = null;
        try
        {
            await using var stream = file.OpenReadStream(MaximumFileSize, _lifetime.Token);
            var result = await ConsumptionService.ImportDailyConsumptionAsync(stream, file.Name,
                new ConsumptionImportOptionsDto { ReferenceMonth = ReferenceDate }, _lifetime.Token);
            if (result.Status == ConsumptionOperationStatus.Completed) await OnImported.InvokeAsync(result);
            else if (result.Status != ConsumptionOperationStatus.Cancelled)
                _error = string.Join(" ", result.Issues.Where(i => i.Severity >= AnalysisSeverity.Error)
                    .Select(i => (i.ItemCode is null ? "" : $"Produto {i.ItemCode}: ") + i.Message));
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            Logger.LogError(ex, "Falha ao importar CSV de consumo.");
            _error = "Não foi possível importar o arquivo. Tente novamente ou consulte o responsável pelo sistema.";
        }
        finally { _processing = false; }
    }
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
    private static string FormatSize(long size) => size >= 1024 * 1024 ? (size / (1024m * 1024m)).ToString("N2", Br) + " MB"
        : size >= 1024 ? (size / 1024m).ToString("N1", Br) + " KB" : size.ToString("N0", Br) + " bytes";
}
