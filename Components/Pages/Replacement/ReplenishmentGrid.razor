@page "/Replacement/ReplacementGrid"
@page "/Estoque/Itens"
@attribute [Authorize(Roles = "Admin,Farmacia,Almoxarifado,Consulta")]
@inject IStockJsonService StockService
@inject IDialogService DialogService
@inject StockDataState StockDataState
@inject ILogger<ReplenishmentGrid> Logger
@implements IDisposable

<PageTitle>Itens em estoque</PageTitle>

<section class="app-grid-card stock-header mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <div>
        <h3>Itens em estoque</h3>
        <p>Consulte os itens registrados e atualize os saldos pelo espelho de estoque.</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick="OpenImportAsync">
        <i class="bi bi-upload" aria-hidden="true"></i> Importar estoque
    </button>
</section>

@if (_loading)
{
    <p role="status">Carregando estoque...</p>
}
else if (_loadError is not null)
{
    <p role="alert">@_loadError</p>
    <button type="button" class="btn btn-secondary" @onclick="LoadStockAsync">Tentar novamente</button>
}
else if (_products.Count == 0)
{
    <p>Nenhum item ativo cadastrado. Importe um espelho de estoque para registrar os itens.</p>
}
else
{
    <section class="app-grid-card stock-table-wrapper rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <table class="stock-table">
            <caption>@_products.Count itens ativos cadastrados</caption>
            <thead>
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Item</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Unidade</th>
                    <th scope="col" class="stock-quantity">Saldo total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in _products)
                {
                    <tr @key="product.Code">
                        <td>@product.Code</td>
                        <td>@product.Name</td>
                        <td>@ItemTypeLabels.GetLabel(product.ItemType)</td>
                        <td>@product.Unit</td>
                        <td class="stock-quantity">@product.TotalStock.ToString("N3")</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private List<ProductStock> _products = new();
    private bool _loading = true;
    private bool _disposed;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        StockDataState.OnChange += HandleStockChanged;
        await LoadStockAsync();
    }

    private async Task LoadStockAsync()
    {
        _loading = true;
        _loadError = null;

        try
        {
            _products = await StockService.GetAllAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Falha ao consultar os itens em estoque.");
            _loadError = "Não foi possível carregar o estoque. Tente novamente.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleStockChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed)
                return;

            await LoadStockAsync();
            if (!_disposed)
                StateHasChanged();
        });
    }

    private async Task OpenImportAsync()
    {
        var dialog = await DialogService.ShowDialogAsync<PopupComponent>(new DialogParameters
        {
            Title = "Atualizar estoque",
            Width = "clamp(22rem, 92vw, 34rem)",
            TrapFocus = true,
            Modal = true,
            PreventScroll = true
        });
        await dialog.Result;
    }

    public void Dispose()
    {
        _disposed = true;
        StockDataState.OnChange -= HandleStockChanged;
    }
}
