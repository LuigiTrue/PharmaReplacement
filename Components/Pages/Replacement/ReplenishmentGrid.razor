@page "/Replacement/ReplacementGrid"
@inject IReplenishmentService ReplenishmentService
@inject ReportHtmlService ReportHtmlService
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.DesignTokens
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>Reposição</PageTitle>

@*<ReplacementNavMenu />*@


<div class="replenishment-grid-shell">
    <section class="app-grid-card mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="replenishment-grid-card-content">
                <h3 class="replenishment-grid-title">Relatório de Reposição</h3>
                <div>
                    <button @onclick="OpenDialogAsync" style="border-radius: 10px;" class="button-top replenishment-grid-action inline-flex items-center gap-2 rounded-md border border-slate-100 bg-slate-0 px-5 py-2 font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-100">
                        <i style="color: var(--color-blue-600)" class="bi bi-upload"></i>
                        <span>Atualizar Dados</span>
                    </button>
                    <button @onclick="OpenPreview" style="border-radius: 10px;" class="button-top  replenishment-grid-action inline-flex items-center gap-2 rounded-md border border-slate-100 bg-slate-0 px-5 py-2 font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-200 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-100">
                        <i style="color: rgba(197, 50, 50, 0.973)" class="bi bi-file-earmark-pdf-fill"></i>
                        <span>Imprimir</span>
                    </button>
                </div>
            </div>
    </section>
</div>







@if (_loading)
{
    <p>Carregando...</p>
}
else if (_report is null)
{
    <p>Nenhum item necessita de reposição no momento.</p>
}
else
{
    <ReplacementSection Title="1ª Etapa — Fracionamento" Items="_report.FromFractionation" LocationId="@Fractionation" />

    <ReplacementSection Title="2ª Etapa — CAF" Items="_report.FromCafOnly" LocationId="@Caf" />

    <ReplacementSection Title="3ª Etapa — Almoxarifado" Items="_report.FromStockOnly" LocationId="@Stock" />
}

@code {
    private ReplenishmentReport? _report;
    private bool _loading = true;

    private const string Fractionation = "1059";
    private const string Caf = "999";
    private const string Stock = "996";

    protected override async Task OnInitializedAsync()
    {
        _report = await ReplenishmentService.GenerateReportAsync();
        _loading = false;
    }

    private async Task OpenPreview()
    {
        var html = ReportHtmlService.GenerateReplacementHtml(_report!);
        await JS.InvokeVoidAsync("openPrintPreview", html);
    }

    private bool _trapFocus = true;
    private bool _modal = true;
    
    AppUser appUser = new();

     private async Task OpenDialogAsync()
    {
     
          DialogParameters parameters = new()
        {
            Title = $"Atualize os dados",
            PrimaryAction = "Yes",
            PrimaryActionEnabled = false,
            SecondaryAction = "No",
            Width = "500px",
            TrapFocus = _trapFocus,
            Modal = _modal,
            PreventScroll = true 
        };

            IDialogReference dialog = await DialogService.ShowDialogAsync<PopupComponent>(parameters);
        DialogResult? result = await dialog.Result;
    
    }
}

