@page "/Replacement/ReplacementGrid"
@attribute [Authorize(Roles = "Admin,Farmacia,Almoxarifado,Consulta")]
@inject IReplenishmentService ReplenishmentService
@inject ReportHtmlService ReportHtmlService
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.DesignTokens
@using RepyPharma.Domain.Entities
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject IAuthService AuthService
@inject ReplenishmentDataState ReplenishmentDataState
@implements IDisposable

<PageTitle>Reposição</PageTitle>

@*<ReplacementNavMenu />*@


<div class="replenishment-grid-shell">
    <section class="app-grid-card mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="replenishment-grid-card-content">
                <h3 class="replenishment-grid-title">Relatório de Reposição</h3>
                <div class="replenishment-grid-actions">
                    <button @onclick="OpenDialogAsync" class="button-top replenishment-grid-action">
                        <i class="bi bi-upload"></i>
                        <span>Atualizar Dados</span>
                    </button>
                    @*
                    <button @onclick="OpenPreview" class="button-top replenishment-grid-action">
                        <i class="bi bi-file-earmark-pdf-fill"></i>
                        <span>Imprimir</span>
                    </button>
                    *@
                </div>
            </div>
    </section>
</div>

<div class="replenishment-tabs-host">
    <input class="replenishment-tab-input" type="radio" name="replenishment-tabs" id="replenishment-tab-table" checked />
    <input class="replenishment-tab-input" type="radio" name="replenishment-tabs" id="replenishment-tab-daily" />
    <input class="replenishment-tab-input" type="radio" name="replenishment-tabs" id="replenishment-tab-dashboard" />
    <input class="replenishment-tab-input" type="radio" name="replenishment-tabs" id="replenishment-tab-fractionation" />
    @if (AuthService.IsAdmin)
    {
        <input class="replenishment-tab-input" type="radio" name="replenishment-tabs" id="replenishment-tab-settings" />
    }

    <div class="app-tabs" role="tablist" aria-label="Secoes do relatorio de reposicao">
        <label class="app-tab" role="tab" for="replenishment-tab-table">Diária</label>
        <label class="app-tab" role="tab" for="replenishment-tab-daily">Consumo </label>
        <label class="app-tab" role="tab" for="replenishment-tab-dashboard">Dashboard</label>
        <label class="app-tab" role="tab" for="replenishment-tab-fractionation">Fracionamento</label>
     @if (AuthService.IsAdmin)
        {
            <label class="app-tab" role="tab" for="replenishment-tab-settings">Configurações</label>
        }
    </div>








   

    <div class="replenishment-tab-panel replenishment-table-panel" role="tabpanel">
        @if (_loading)
        {
            <p>Carregando...</p>
        }
        else if (_report is null)
        {
            <p>Nenhum item necessita de reposição no momento.</p>
        }
        else
        {
  <section class="app-grid-card daily-replenishment-header mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <div class="daily-replenishment-heading">
        <div>
            <h4 class="daily-replenishment-title">Reposição diária</h4>
            <p class="daily-replenishment-description">Seção destinada à reposição diária.</p>
        </div>

        <div class="daily-replenishment-controls">
            <div class="daily-coverage-menu">
               
            </div>
        </div>
    </div>
</section>

            <section class="replenishment-table-metrics mb-4">
                <article class="metric-card border-slate-200 dark:border-slate-500">
                    <p class="metric-label">Itens para repor</p>
                    <p class="metric-value danger">@TableItems.Count</p>
                </article>
                <article class="metric-card border-slate-200 dark:border-slate-500">
                    <p class="metric-label">Sem fonte</p>
                    <p class="metric-value warning">@_report.NoSourceAvailable.Count</p>
                </article>
                <article class="metric-card border-slate-200 dark:border-slate-500">
                    <p class="metric-label">Materiais</p>
                    <p class="metric-value info">@TableMaterialCount</p>
                </article>
                <article class="metric-card border-slate-200 dark:border-slate-500">
                    <p class="metric-label">Medicamentos</p>
                    <p class="metric-value success">@TableMedicationCount</p>
                </article>
            </section>

            <ReplacementSection Title="1ª Etapa — Fracionamento" Items="_report.FromFractionation" LocationId="@Fractionation" />

            <ReplacementSection Title="2ª Etapa — CAF" Items="_report.FromCafOnly" LocationId="@Caf" />

            <ReplacementSection Title="3ª Etapa — Almoxarifado" Items="_report.FromStockOnly" LocationId="@Stock" />
        }
    </div>

    <div class="replenishment-tab-panel replenishment-daily-panel" role="tabpanel">
        <DailyReplenishmentPanel />
    </div>

    <div class="replenishment-tab-panel replenishment-dashboard-panel" role="tabpanel">
       <Dashboard></Dashboard>
    </div>

    <div class="replenishment-tab-panel replenishment-fractionation-panel" role="tabpanel">
        <FractionationSupplyPanel />
    </div>

    @if (AuthService.IsAdmin)
    {
        <div class="replenishment-tab-panel replenishment-settings-tab-panel" role="tabpanel">
            <ReplenishmentSettings />
        </div>
    }
</div>

@code {
    private ReplenishmentReport? _report;
    private DashboardSummary? _summary;
    private bool _loading = true;

    private const string Fractionation = "1059";
    private const string Caf = "999";
    private const string Stock = "996";

    private List<ReplenishmentItem> TableItems => _report is null
        ? new()
        : _report.FromFractionation
            .Concat(_report.FromCafOnly)
            .Concat(_report.FromStockOnly)
            .Concat(_report.NoSourceAvailable)
            .ToList();

    private int TableMaterialCount => TableItems.Count(item => item.ItemType == ItemType.Material);
    private int TableMedicationCount => TableItems.Count - TableMaterialCount;

    protected override async Task OnInitializedAsync()
    {
        ReplenishmentDataState.OnChange += HandleReplenishmentDataChanged;
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);

        _report = await ReplenishmentService.GenerateReportAsync();
        _summary = await ReplenishmentService.GetDashboardSummaryAsync();
        _loading = false;
    }

    private void HandleReplenishmentDataChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadReportAsync();
            StateHasChanged();
        });
    }

    private async Task OpenPreview()
    {
        var html = ReportHtmlService.GenerateReplacementHtml(_report!);
        await JS.InvokeVoidAsync("openPrintPreview", html);
    }

    private bool _trapFocus = true;
    private bool _modal = true;
    
     private async Task OpenDialogAsync()
    {
     
          DialogParameters parameters = new()
        {
            Title = $"Atualize os dados",
            PrimaryAction = "Yes",
            PrimaryActionEnabled = false,
            SecondaryAction = "No",
            Width = "clamp(22rem, 92vw, 46rem)",
            TrapFocus = _trapFocus,
            Modal = _modal,
            PreventScroll = true 
        };

            IDialogReference dialog = await DialogService.ShowDialogAsync<PopupComponent>(parameters);
        DialogResult? result = await dialog.Result;
    
    }

    public void Dispose()
    {
        ReplenishmentDataState.OnChange -= HandleReplenishmentDataChanged;
    }
}
