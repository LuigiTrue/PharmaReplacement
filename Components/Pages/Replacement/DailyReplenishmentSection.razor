@using RepyPharma.Models
@using System.Net
@using System.Text
@inject IJSRuntime JS

<section class="app-grid-card daily-replenishment-section mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <div class="mb-3 flex items-center justify-between gap-3">
        <div class="daily-section-title-row">
            <span class="text-sm font-semibold text-slate-900 dark:text-slate-100">@Title</span>
            <button type="button"
                    class="daily-section-toggle @(_expanded ? "expanded" : "collapsed")"
                    title="@(_expanded ? "Recolher" : "Expandir")"
                    aria-expanded="@_expanded"
                    @onclick="ToggleExpanded">
                            <i @key="_expanded"
                       class="bi @(_expanded ? "bi-chevron-compact-up" : "bi-chevron-compact-down")"
                       aria-hidden="true"></i>
            </button>
        </div>
        <div class="daily-section-tools">
            @*
            <button type="button"
                    class="daily-section-print-action"
                    disabled="@(!Items.Any())"
                    @onclick="PrintAsync">
                <i class="bi bi-printer-fill" aria-hidden="true"></i>
                <span>Imprimir</span>
            </button>
            *@

            <div class="@BadgeClass">
                <span class="h-2 w-2 rounded-full @BadgeDotClass"></span>
                <span>@Items.Count itens</span>
            </div>
        </div>
    </div>

    @if (_expanded && !Items.Any())
    {
        <p class="text-sm text-slate-500 dark:text-slate-400">@EmptyText</p>
    }
    else if (_expanded)
    {
        <div class="app-grid overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-700">
            <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-700">
                <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-800 dark:text-slate-300">
                    <tr>
                        <th scope="col" class="px-3 py-3 text-left font-semibold">Código</th>
                        <th scope="col" class="px-2 py-3 text-left font-semibold">Descrição</th>
                        <th scope="col" class="px-3 py-3 text-left font-semibold">Unidade</th>
                        <th scope="col" class="px-3 py-3 text-left font-semibold">Média</th>
                        <th scope="col" class="px-3 py-3 text-left font-semibold">Saldo Farmácia</th>
                        <th scope="col" class="px-3 py-3 text-left font-semibold">Saldo Fracionamento</th>
                        <th scope="col" class="px-4 py-3 text-left font-semibold">Solicitar</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white text-slate-700 dark:divide-slate-800 dark:bg-slate-900 dark:text-slate-100">
                    @foreach (var item in Items)
                    {
                        <tr class="transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/70">
                            <td class="whitespace-nowrap px-3 py-3 align-top font-medium text-slate-900 dark:text-slate-100">@item.Code</td>
                            <td class="min-w-72 px-2 py-3 align-top">@item.Name</td>
                            <td class="whitespace-nowrap px-3 py-3 align-top">@item.Unit</td>
                            <td class="whitespace-nowrap px-3 py-3 align-top">@item.AverageOutput.ToString("0")</td>
                            <td class="whitespace-nowrap px-3 py-3 align-top">@item.CurrentStock.ToString("0.##")</td>
                            <td class="whitespace-nowrap px-3 py-3 align-top">@item.ProjectionDays.ToString("0.##")</td>
                            <td class="whitespace-nowrap px-4 py-3 align-top font-semibold text-slate-900 dark:text-slate-100">@item.SuggestedQuantity.ToString("0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string EmptyText { get; set; } = "";
    [Parameter, EditorRequired] public List<DailyReplenishmentItem> Items { get; set; } = new();
    [Parameter] public string BadgeTone { get; set; } = "default";
    private bool _expanded = true;

    private string BadgeClass => BadgeTone == "warning"
        ? "inline-flex items-center gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-700 shadow-sm dark:border-amber-900 dark:bg-slate-800 dark:text-amber-300"
        : "inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200";

    private string BadgeDotClass => BadgeTone == "warning"
        ? "bg-amber-500 dark:bg-amber-300"
        : "bg-slate-500 dark:bg-slate-300";

    private void ToggleExpanded()
    {
        _expanded = !_expanded;
    }

    private async Task PrintAsync()
    {
        if (!Items.Any())
            return;

        await JS.InvokeVoidAsync("openPrintPreview", BuildPrintHtml());
    }

    private string BuildPrintHtml()
    {
        var html = new StringBuilder();
        html.Append("<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>Reposição diária</title>\n<style>\nbody{font-family:Arial,sans-serif;margin:24px;color:#1f2937}\nh1{font-size:20px;margin:0 0 4px}\np{margin:0 0 16px;color:#4b5563}\ntable{width:100%;border-collapse:collapse;font-size:12px}\nth,td{border:1px solid #d1d5db;padding:8px;text-align:left}\nth{background:#f3f4f6;font-weight:700}\n</style>\n</head>\n<body>\n");
        html.Append("<h1>").Append(Escape(Title)).Append("</h1>");
        html.Append("<p>").Append(Items.Count).Append(" itens</p>");
        html.Append("<table>\n<thead>\n<tr>\n<th>Código</th>\n<th>Descrição</th>\n<th>Unidade</th>\n<th>Média</th>\n<th>Saldo Farmácia</th>\n<th>Saldo Fracionamento</th>\n<th>Solicitar</th>\n</tr>\n</thead>\n<tbody>\n");

        foreach (var item in Items)
        {
            html.Append("<tr>");
            html.Append("<td>").Append(Escape(item.Code)).Append("</td>");
            html.Append("<td>").Append(Escape(item.Name)).Append("</td>");
            html.Append("<td>").Append(Escape(item.Unit)).Append("</td>");
            html.Append("<td>").Append(Escape(item.AverageOutput.ToString("0"))).Append("</td>");
            html.Append("<td>").Append(Escape(item.CurrentStock.ToString("0.##"))).Append("</td>");
            html.Append("<td>").Append(Escape(item.ProjectionDays.ToString("0.##"))).Append("</td>");
            html.Append("<td>").Append(Escape(item.SuggestedQuantity.ToString("0"))).Append("</td>");
            html.Append("</tr>");
        }

        html.Append("</tbody>\n</table>\n</body>\n</html>");
        return html.ToString();
    }

    private static string Escape(string? value) => WebUtility.HtmlEncode(value ?? "");
}
