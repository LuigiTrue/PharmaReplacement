@page "/Dialog"
@inject IDialogService DialogService

<FluentButton OnClick="@AbrirDialog">Abrir</FluentButton>

@code {
    private async Task AbrirDialog()
    {
        var dialog = await DialogService.ShowDialogAsync<PopupComponent>(
            "Tem certeza que deseja continuar?",
            new DialogParameters
            {
                Title = "Confirmação",
                Modal = true,
                ShowDismiss = true,
            });

        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            // usuário confirmou
        }
    }
}