@inject IReplacementSettingsService SettingsService

<section class="app-grid-card replacement-settings-card mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <div class="replacement-settings-header">
        <div>
            <h4 class="replacement-settings-title">Configurações de Reposição</h4>
            <p class="replacement-settings-description">Altere a prioridade e o estoque mínimo dos itens monitorados pelo abastecimento.</p>
        </div>
    </div>

    <div class="replacement-settings-form">
        <label class="replacement-settings-field">
            <span>Pesquisar item</span>
            <input class="replacement-settings-input"
                   type="search"
                   placeholder="Digite o código ou nome do item"
                   @bind="_searchText"
                   @bind:event="oninput"
                   @bind:after="SearchItemsAsync" />
        </label>

        <label class="replacement-settings-field">
            <span>Prioridade</span>
            <select class="replacement-settings-input"
                    @bind="_selectedPriority"
                    disabled="@(_selectedItem is null)">
                @foreach (var priority in _priorities)
                {
                    <option value="@priority">@GetPriorityLabel(priority)</option>
                }
            </select>
        </label>

        <label class="replacement-settings-field">
            <span>Estoque mínimo</span>
            <input class="replacement-settings-input"
                   type="number"
                   min="0"
                   step="0.01"
                   @bind="_selectedMinimumQuantity"
                   disabled="@(_selectedItem is null)" />
        </label>

        <button type="button"
                class="replacement-settings-save"
                disabled="@(!CanSave)"
                @onclick="SaveSettingsAsync">
            Salvar configurações
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="replacement-settings-message">@_message</p>
    }

    @if (_loading)
    {
        <p class="replacement-settings-description">Carregando itens...</p>
    }
    else if (_searchResults.Count == 0)
    {
        <p class="replacement-settings-description">Nenhum item encontrado.</p>
    }
    else
    {
        <div class="replacement-settings-results">
            @foreach (var item in _searchResults)
            {
                var selected = _selectedItem?.Code == item.Code;

                <button type="button"
                        class="replacement-settings-result @(selected ? "selected" : null)"
                        @onclick="() => SelectItem(item)">
                    <span class="replacement-settings-result-main">
                        <strong>@item.Name</strong>
                        <small>@item.Code • mínimo @item.MinimumQuantity.ToString("0.##")</small>
                    </span>
                    <span class="replacement-settings-chip">@GetPriorityLabel(item.ItemPriority)</span>
                </button>
            }
        </div>
    }
</section>

@code {
    private readonly ItemPriority[] _priorities =
    [
        ItemPriority.UltraHigh,
        ItemPriority.High,
        ItemPriority.Moderate,
        ItemPriority.Low
    ];

    private string _searchText = "";
    private string? _message;
    private bool _loading = true;
    private bool _saving;
    private ItemPriority _selectedPriority = ItemPriority.Low;
    private decimal _selectedMinimumQuantity;
    private ReplacementSettingsItem? _selectedItem;
    private List<ReplacementSettingsItem> _searchResults = new();

    private bool CanSave => _selectedItem is not null && !_saving && _selectedMinimumQuantity >= 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadItemsAsync();
    }

    private async Task SearchItemsAsync()
    {
        _message = null;
        await LoadItemsAsync();
    }

    private async Task LoadItemsAsync()
    {
        _loading = true;
        _searchResults = await SettingsService.SearchPriorityItemsAsync(_searchText);
        _loading = false;
    }

    private void SelectItem(ReplacementSettingsItem item)
    {
        _selectedItem = item;
        _selectedPriority = item.ItemPriority;
        _selectedMinimumQuantity = item.MinimumQuantity;
        _message = null;
    }

    private async Task SaveSettingsAsync()
    {
        if (_selectedItem is null)
            return;

        _saving = true;
        await SettingsService.UpdateItemSettingsAsync(_selectedItem.Code, _selectedPriority, _selectedMinimumQuantity);

        var updatedItem = await SettingsService.GetPriorityItemAsync(_selectedItem.Code);
        _selectedItem = updatedItem;
        if (updatedItem is not null)
        {
            _selectedPriority = updatedItem.ItemPriority;
            _selectedMinimumQuantity = updatedItem.MinimumQuantity;
        }

        await LoadItemsAsync();

        _message = updatedItem is null
            ? "Configurações atualizadas."
            : $"Configurações de {updatedItem.Name} atualizadas: prioridade {GetPriorityLabel(updatedItem.ItemPriority)} e mínimo {updatedItem.MinimumQuantity:0.##}.";

        _saving = false;
    }

    private static string GetPriorityLabel(ItemPriority priority) => priority switch
    {
        ItemPriority.UltraHigh => "Muito alta",
        ItemPriority.High => "Alta",
        ItemPriority.Moderate => "Moderada",
        ItemPriority.Low => "Baixa",
        _ => priority.ToString()
    };
}
