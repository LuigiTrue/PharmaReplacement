@using RepyPharma.Models
@using System.Net
@using System.Text
@inject IJSRuntime JS

<section class="app-grid-card mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
    <div class="mb-3 flex items-center justify-between gap-3">
        <div class="replacement-section-title-row">
            <span class="text-sm font-semibold text-slate-900 dark:text-slate-100">@Title</span>
            <button type="button"
                    class="replacement-section-toggle @(_expanded ? "expanded" : "collapsed")"
                    title="@(_expanded ? "Recolher" : "Expandir")"
                    aria-expanded="@_expanded"
                    @onclick="ToggleExpanded">
                <i @key="_expanded"
                   class="bi @(_expanded ? "bi-chevron-compact-up" : "bi-chevron-compact-down")"
                   aria-hidden="true"></i>
            </button>
        </div>
        <div class="replacement-section-tools">
            <label class="replacement-type-filter">
                <span>Tipo</span>
                <select value="@GetSelectedItemTypeValue()" @onchange="OnItemTypeChanged">
                    <option value="">Todos</option>
                    @foreach (var itemType in _itemTypes)
                    {
                        <option value="@((int)itemType)">@ItemTypeLabels.GetLabel(itemType)</option>
                    }
                </select>
            </label>

            @*
            <button type="button"
                    class="replacement-section-print-action"
                    disabled="@(!FilteredItems.Any())"
                    @onclick="PrintAsync">
                <i class="bi bi-printer-fill" aria-hidden="true"></i>
                <span>Imprimir</span>
            </button>
            *@

            <div class="inline-flex items-center gap-2 rounded-lg border px-3 py-1.5 text-xs font-semibold shadow-sm @(FilteredItems.Any() ? "border-slate-200 bg-slate-100 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200" : "border-blue-200 bg-blue-50 text-blue-700 dark:border-blue-900 dark:bg-slate-800 dark:text-blue-300")">
                <span class="h-2 w-2 rounded-full @(FilteredItems.Any() ? "bg-slate-500 dark:bg-slate-300" : "bg-blue-500 dark:bg-blue-300")"></span>
                <span>@FilteredItems.Count itens</span>
            </div>
        </div>
    </div>

    @if (_expanded && !FilteredItems.Any())
    {
        <p class="text-sm text-slate-500 dark:text-slate-400">Nenhum item nesta etapa.</p>
    }
    else if (_expanded)
    {
        <div class="app-grid overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-700">
            <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-700">
                <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-800 dark:text-slate-300">
                    <tr>
                        <th scope="col" class="px-3 py-3 text-left font-semibold">Código</th>
                        <th scope="col" class="px-1 py-3 text-left font-semibold">Nome</th>
                        <th scope="col" class="px-3 py-3 text-left font-semibold">Tipo</th>
                        <th scope="col" class="px-4 py-3 text-left font-semibold">Lotes Disponíveis</th>
                        <th scope="col" class="px-3 py-3 text-left font-semibold">Estoque Atual</th>
                        <th scope="col" class="px-5 py-1 text-left font-semibold">Qtd para repor</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white text-slate-700 dark:divide-slate-800 dark:bg-slate-900 dark:text-slate-100">
                    @foreach (var item in FilteredItems)
                    {
                        <tr class="transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/70">
                            <td class="whitespace-nowrap px-3 py-3 align-top font-medium text-slate-900 dark:text-slate-100">@item.Code</td>
                            <td class="min-w-72 px-1 py-3 align-top">@item.Name</td>
                            <td class="whitespace-nowrap px-3 py-3 align-top">@ItemTypeLabels.GetLabel(item.ItemType)</td>
                            <td class="min-w-[420px] px-4 py-3 align-top">
                                @if (!item.AvailableBatches.Any())
                                {
                                    <span class="text-sm font-medium text-red-600 dark:text-red-300">Sem estoque disponível</span>
                                }
                                else
                                {
                                    <div class="flex flex-col gap-1.5">
                                        @foreach (var batch in item.AvailableBatches)
                                        {
                                            var isRecommended = batch.Batch == item.RecommendedBatch?.Batch;
                                            var batchClass = isRecommended
                                                ? "font-semibold text-blue-600 dark:text-blue-300"
                                                : "text-slate-700 dark:text-slate-100";

                                            @foreach (var location in batch.Locations.Where(l => l.LocationId == LocationId && l.Quantity > 0))
                                            {
                                                <div class="grid grid-cols-[140px_70px_80px_80px] items-center gap-x-2">
                                                    <span class="whitespace-nowrap text-xs @batchClass">@batch.Batch</span>
                                                    <span class="whitespace-nowrap text-xs text-slate-500 dark:text-slate-400">
                                                        @(batch.Validity.HasValue ? batch.Validity.Value.ToString("MM/yyyy") : "-")
                                                    </span>
                                                    <span class="whitespace-nowrap text-xs @batchClass">@location.Quantity un.</span>
                                                    <span>
                                                        @if (isRecommended)
                                                        {
                                                            <span class="rounded-full bg-blue-100 px-1.5 py-0.5 text-[10px] font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-300">
                                                                indicado
                                                            </span>
                                                        }
                                                    </span>
                                                </div>
                                            }
                                        }

                                        @if (item.HasLotConflict)
                                        {
                                            <span class="mt-1 text-xs font-medium text-red-600 dark:text-red-300">
                                                Lote diferente do que está na farmácia
                                            </span>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="min-w-52 px-3 py-3 align-top">@item.CurrentStock.ToString("0.##") und</td>
                            <td class="min-w-72 px-5 py-3 align-top">@item.MissingQuantity.ToString("0.##") und</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private readonly ItemType[] _itemTypes = Enum.GetValues<ItemType>();
    private ItemType? _selectedItemType;
    private bool _expanded = true;

    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public List<ReplenishmentItem> Items { get; set; } = new();
    [Parameter, EditorRequired] public string LocationId { get; set; } = "";

    private List<ReplenishmentItem> FilteredItems => _selectedItemType is null
        ? Items
        : Items.Where(item => item.ItemType == _selectedItemType).ToList();

    private string GetSelectedItemTypeValue() => _selectedItemType.HasValue
        ? ((int)_selectedItemType.Value).ToString()
        : "";

    private void OnItemTypeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var rawValue) &&
            Enum.IsDefined(typeof(ItemType), rawValue))
        {
            _selectedItemType = (ItemType)rawValue;
            return;
        }

        _selectedItemType = null;
    }

    private void ToggleExpanded()
    {
        _expanded = !_expanded;
    }

    private async Task PrintAsync()
    {
        if (!FilteredItems.Any())
            return;

        await JS.InvokeVoidAsync("openPrintPreview", BuildPrintHtml());
    }

    private string BuildPrintHtml()
    {
        var html = new StringBuilder();
        html.Append("<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>Relatório de Reposição</title>\n<style>\nbody{font-family:Arial,sans-serif;margin:24px;color:#1f2937}\nh1{font-size:20px;margin:0 0 4px}\np{margin:0 0 16px;color:#4b5563}\ntable{width:100%;border-collapse:collapse;font-size:12px}\nth,td{border:1px solid #d1d5db;padding:8px;text-align:left;vertical-align:top}\nth{background:#f3f4f6;font-weight:700}\n</style>\n</head>\n<body>\n");
        html.Append("<h1>").Append(Escape(Title)).Append("</h1>");
        html.Append("<p>").Append(FilteredItems.Count).Append(" itens</p>");
        html.Append("<table>\n<thead>\n<tr>\n<th>Código</th>\n<th>Nome</th>\n<th>Tipo</th>\n<th>Lotes disponíveis</th>\n<th>Estoque atual</th>\n<th>Qtd para repor</th>\n</tr>\n</thead>\n<tbody>\n");

        foreach (var item in FilteredItems)
        {
            html.Append("<tr>");
            html.Append("<td>").Append(Escape(item.Code)).Append("</td>");
            html.Append("<td>").Append(Escape(item.Name)).Append("</td>");
            html.Append("<td>").Append(Escape(ItemTypeLabels.GetLabel(item.ItemType))).Append("</td>");
            html.Append("<td>").Append(Escape(FormatAvailableBatches(item))).Append("</td>");
            html.Append("<td>").Append(Escape(item.CurrentStock.ToString("0.##"))).Append(" und</td>");
            html.Append("<td>").Append(Escape(item.MissingQuantity.ToString("0.##"))).Append(" und</td>");
            html.Append("</tr>");
        }

        html.Append("</tbody>\n</table>\n</body>\n</html>");
        return html.ToString();
    }

    private string FormatAvailableBatches(ReplenishmentItem item)
    {
        var batches = item.AvailableBatches
            .SelectMany(batch => batch.Locations
                .Where(location => location.LocationId == LocationId && location.Quantity > 0)
                .Select(location =>
                {
                    var validity = batch.Validity.HasValue ? batch.Validity.Value.ToString("MM/yyyy") : "-";
                    var suffix = batch.Batch == item.RecommendedBatch?.Batch ? " (indicado)" : "";
                    return $"{batch.Batch} | {validity} | {location.Quantity:0.##} un.{suffix}";
                }))
            .ToList();

        return batches.Count == 0 ? "Sem estoque disponível" : string.Join("; ", batches);
    }

    private static string Escape(string? value) => WebUtility.HtmlEncode(value ?? "");
}
