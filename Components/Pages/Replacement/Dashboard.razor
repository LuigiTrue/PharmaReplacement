@page "/Dashboard"
@inject IReplenishmentService ReplenishmentService
@using RepyPharma.Models
@using ApexCharts

<PageTitle>Dashboard</PageTitle>

@if (_loading)
{
    <p>Carregando...</p>
}
else if (_summary is not null)
{
     <section class="app-grid-card mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
          <div class="section-conteiner">
            <div class="metric-card border-slate-200 dark:border-slate-500">
                <p class="metric-label">Precisam ser comprados</p>
                <p class="metric-value danger">@_summary.NeedToBuy.Count</p>
            </div>
            <div class="metric-card">
                <p class="metric-label">Acabando em breve</p>
                <p class="metric-value warning">@_summary.RunningLow.Count</p>
            </div>
            <div class="metric-card">
                <p class="metric-label">Acima do normal</p>
                <p class="metric-value info">@_summary.AboveNormal.Count</p>
            </div>
          </div>
     </section>

    <section class="dashboard-charts-grid">
        <div class="app-grid-card dashboard-chart-card rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <h4 class="dashboard-chart-title">Distribuição por status</h4>
            <ApexChart TItem="DashboardChartPoint" Height="320" Options="_pieChartOptions">
                <ApexPointSeries TItem="DashboardChartPoint"
                                 Items="_chartPoints"
                                 SeriesType="SeriesType.Pie"
                                 XValue="@(item => item.Category)"
                                 YValue="@(item => item.Count)" />
            </ApexChart>
        </div>

        <div class="app-grid-card dashboard-chart-card rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <h4 class="dashboard-chart-title">Quantidade por status</h4>
            <ApexChart TItem="DashboardChartPoint" Height="320" Options="_barChartOptions">
                <ApexPointSeries TItem="DashboardChartPoint"
                                 Name="Itens"
                                 Items="_chartPoints"
                                 SeriesType="SeriesType.Bar"
                                 XValue="@(item => item.Category)"
                                 YValue="@(item => item.Count)" />
            </ApexChart>
        </div>
    </section>

    <DashboardSection Title="Precisam ser comprados" BadgeClass="danger" BadgeLabel="Crítico" Items="_summary.NeedToBuy" />

    <DashboardSection Title="Acabando em breve" BadgeClass="warning" BadgeLabel="Atenção" Items="_summary.RunningLow" />

    <DashboardSection Title="Acima do normal" BadgeClass="info" BadgeLabel="Informativo" Items="_summary.AboveNormal" />

}

@code {
    private DashboardSummary? _summary;
    private bool _loading = true;
    private List<DashboardChartPoint> _chartPoints = new();
    private ApexChartOptions<DashboardChartPoint> _pieChartOptions = new();
    private ApexChartOptions<DashboardChartPoint> _barChartOptions = new();

    protected override async Task OnInitializedAsync()
    {
        _summary = await ReplenishmentService.GetDashboardSummaryAsync();
        _chartPoints = BuildChartPoints(_summary);
        _pieChartOptions = BuildPieChartOptions();
        _barChartOptions = BuildBarChartOptions();
        _loading = false;
    }

    private static List<DashboardChartPoint> BuildChartPoints(DashboardSummary summary)
    {
        return new List<DashboardChartPoint>
        {
            new("Precisam ser comprados", summary.NeedToBuy.Count),
            new("Acabando em breve", summary.RunningLow.Count),
            new("Acima do normal", summary.AboveNormal.Count)
        };
    }

    private static ApexChartOptions<DashboardChartPoint> BuildPieChartOptions()
    {
        return new ApexChartOptions<DashboardChartPoint>
        {
            Chart = new Chart
            {
                Type = ChartType.Pie,
                Toolbar = new Toolbar { Show = false }
            },
            Labels = new List<string>
            {
                "Precisam ser comprados",
                "Acabando em breve",
                "Acima do normal"
            },
            Colors = ChartColors,
            Legend = new Legend
            {
                Position = LegendPosition.Bottom
            },
            DataLabels = new DataLabels
            {
                Enabled = true
            }
        };
    }

    private static ApexChartOptions<DashboardChartPoint> BuildBarChartOptions()
    {
        return new ApexChartOptions<DashboardChartPoint>
        {
            Chart = new Chart
            {
                Type = ChartType.Bar,
                Toolbar = new Toolbar { Show = false }
            },
            Colors = ChartColors,
            Legend = new Legend
            {
                Show = false
            },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    BorderRadius = 6,
                    ColumnWidth = "48%"
                }
            },
            DataLabels = new DataLabels
            {
                Enabled = false
            }
        };
    }

    private static readonly List<string> ChartColors = new()
    {
        "#8B3FE0",
        "#E8924F",
        "#3320C9"
    };

    private sealed record DashboardChartPoint(string Category, int Count);
}
