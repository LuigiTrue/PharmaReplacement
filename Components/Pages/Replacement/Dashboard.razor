@page "/Dashboard"
@inject IReplenishmentService ReplenishmentService
@inject IReplenishmentDashboardService ReplenishmentDashboardService
@using RepyPharma.Models
@using ApexCharts

<PageTitle>Dashboard</PageTitle>

@if (_loading)
{
    <p>Carregando...</p>
}
else if (_summary is not null && _dashboardData is not null)
{
     <section class="app-grid-card dashboard-summary-card mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
          <div class="section-conteiner">
            <div class="metric-card border-slate-200 dark:border-slate-500">
                <p class="metric-label">Reposição concluída</p>
                <p class="metric-value success">@_dashboardData.ReplenishmentCompletionPercentage.ToString("0.#")%</p>
            </div>
            <div class="metric-card border-slate-200 dark:border-slate-500">
                <p class="metric-label">Precisam ser comprados</p>
                <p class="metric-value danger">@_summary.NeedToBuy.Count</p>
            </div>
            <div class="metric-card">
                <p class="metric-label">Acabando em breve</p>
                <p class="metric-value warning">@_summary.RunningLow.Count</p>
            </div>
            <div class="metric-card">
                <p class="metric-label">Acima do normal</p>
                <p class="metric-value info">@_summary.AboveNormal.Count</p>
            </div>
          </div>
     </section>

    <section class="dashboard-charts-grid">
        <div class="app-grid-card dashboard-chart-card rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <h4 class="dashboard-chart-title">Itens no mínimo - @_dashboardData.LocationName</h4>
            <div class="dashboard-chart-viewport">
                <ApexChart TItem="ReplenishmentDashboardChartPoint" Height="320" Options="_pieChartOptions">
                    <ApexPointSeries TItem="ReplenishmentDashboardChartPoint"
                                     Items="_dashboardData.CompletionChart"
                                     SeriesType="SeriesType.Pie"
                                     XValue="@(item => item.Label)"
                                     YValue="@(item => item.Value)" />
                </ApexChart>
            </div>
        </div>

        <div class="app-grid-card dashboard-chart-card rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <h4 class="dashboard-chart-title">Itens abaixo do mínimo por prioridade</h4>
            <div class="dashboard-chart-viewport">
                <ApexChart TItem="ReplenishmentDashboardChartPoint" Height="320" Options="_barChartOptions">
                    <ApexPointSeries TItem="ReplenishmentDashboardChartPoint"
                                     Name="Itens abaixo do mínimo"
                                     Items="_dashboardData.MissingByItemChart"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(item => item.Label)"
                                     YValue="@(item => item.Value)" />
                </ApexChart>
            </div>
        </div>
    </section>

    <section class="app-grid-card dashboard-chart-card dashboard-chart-card-wide dashboard-top-items-chart rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <h4 class="dashboard-chart-title">Top 10 itens para reposição</h4>
        <div class="dashboard-chart-viewport dashboard-top-items-scroll">
            <ApexChart TItem="ReplenishmentDashboardChartPoint" Height="420" Options="_topItemsChartOptions">
                <ApexPointSeries TItem="ReplenishmentDashboardChartPoint"
                                 Name="Quantidade faltante"
                                 Items="_dashboardData.TopReplenishmentItemsChart"
                                 SeriesType="SeriesType.Bar"
                                 XValue="@(item => item.Label)"
                                 YValue="@(item => item.Value)" />
            </ApexChart>
        </div>
    </section>

}

@code {
    private DashboardSummary? _summary;
    private ReplenishmentDashboardData? _dashboardData;
    private bool _loading = true;
    private ApexChartOptions<ReplenishmentDashboardChartPoint> _pieChartOptions = new();
    private ApexChartOptions<ReplenishmentDashboardChartPoint> _barChartOptions = new();
    private ApexChartOptions<ReplenishmentDashboardChartPoint> _topItemsChartOptions = new();

    protected override async Task OnInitializedAsync()
    {
        _summary = await ReplenishmentService.GetDashboardSummaryAsync();
        _dashboardData = await ReplenishmentDashboardService.GetDashboardDataAsync();
        _pieChartOptions = BuildPieChartOptions();
        _barChartOptions = BuildBarChartOptions();
        _topItemsChartOptions = BuildTopItemsChartOptions();
        _loading = false;
    }

    private static ApexChartOptions<ReplenishmentDashboardChartPoint> BuildPieChartOptions()
    {
        return new ApexChartOptions<ReplenishmentDashboardChartPoint>
        {
            Chart = new Chart
            {
                Type = ChartType.Pie,
                Toolbar = new Toolbar { Show = false }
            },
            Labels = new List<string>
            {
                "Itens no mínimo ou acima",
                "Itens abaixo do mínimo"
            },
            Colors = ChartColors,
            Legend = new Legend
            {
                Position = LegendPosition.Bottom
            },
            DataLabels = new DataLabels
            {
                Enabled = true
            }
        };
    }

    private static ApexChartOptions<ReplenishmentDashboardChartPoint> BuildBarChartOptions()
    {
        return new ApexChartOptions<ReplenishmentDashboardChartPoint>
        {
            Chart = new Chart
            {
                Type = ChartType.Bar,
                Toolbar = new Toolbar { Show = false }
            },
            Colors = ChartColors,
            Legend = new Legend
            {
                Show = false
            },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    BorderRadius = 6,
                    ColumnWidth = "48%"
                }
            },
            DataLabels = new DataLabels
            {
                Enabled = false
            }
        };
    }

    private static ApexChartOptions<ReplenishmentDashboardChartPoint> BuildTopItemsChartOptions()
    {
        return new ApexChartOptions<ReplenishmentDashboardChartPoint>
        {
            Chart = new Chart
            {
                Type = ChartType.Bar,
                Toolbar = new Toolbar { Show = false }
            },
            Colors = TopItemsChartColors,
            Legend = new Legend
            {
                Show = false
            },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    Horizontal = true,
                    BorderRadius = 6,
                    BarHeight = "70%"
                }
            },
            DataLabels = new DataLabels
            {
                Enabled = false
            }
        };
    }

    private static readonly List<string> ChartColors = new()
    {
        "var(--dashboard-chart-green, #16A34A)",
        "var(--dashboard-chart-orange, #F97316)",
        "var(--dashboard-chart-pink, #E03F97)",
        "var(--dashboard-chart-purple, #8B3FE0)",
        "var(--dashboard-chart-blue, #1BAEDB)"
    };

    private static readonly List<string> TopItemsChartColors = new()
    {
        "var(--dashboard-chart-top-items, #EA580C)"
    };
}
