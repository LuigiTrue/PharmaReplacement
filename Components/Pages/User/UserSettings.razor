@page "/User/Settings"
@attribute [Authorize]
@inject IAuthService AuthService
@inject IUserSettingsService UserSettingsService
@inject NavigationManager Navigation

<PageTitle>Configurações do usuário</PageTitle>

@if (_loading)
{
    <p>Carregando...</p>
}
else if (_profile is not null)
{
    <section class="app-grid-card user-settings-card mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <div>
            <h3 class="user-settings-title">Configurações do usuário</h3>
            <p class="user-settings-description">Atualize seu perfil e solicite alteração de senha.</p>
        </div>

        <div class="user-settings-profile">
            <div class="user-settings-avatar-preview">
                @if (!string.IsNullOrWhiteSpace(_avatarDataUrl))
                {
                    <img src="@_avatarDataUrl" alt="Imagem do usuário" />
                }
                else
                {
                    <span>@Initials</span>
                }
            </div>

            <div class="user-settings-form">
                <label class="user-settings-field">
                    <span>Nome</span>
                    <input class="user-settings-input" type="text" @bind="_name" @bind:event="oninput" />
                </label>

                <label class="user-settings-field">
                    <span>Imagem do usuário</span>
                    <InputFile class="user-settings-input" accept="image/png,image/jpeg,image/webp" OnChange="UploadAvatarAsync" />
                </label>

                <button type="button" class="user-settings-button" disabled="@_saving" @onclick="SaveProfileAsync">
                    Salvar perfil
                </button>
            </div>
        </div>
    </section>

    <section class="app-grid-card user-settings-card mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <div>
            <h4 class="user-settings-section-title">Senha</h4>
            <p class="user-settings-description">Solicite a alteração da sua senha para o administrador.</p>
        </div>

        <button type="button"
                class="user-settings-button"
                disabled="@(_saving || _profile.PasswordChangeRequested)"
                @onclick="RequestPasswordChangeAsync">
            @(_profile.PasswordChangeRequested ? "Solicitação enviada" : "Solicitar alteração de senha")
        </button>
    </section>

    @if (AuthService.IsAdmin)
    {
        <section class="app-grid-card user-settings-card mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div>
                <h4 class="user-settings-section-title">Solicitações de alteração de senha</h4>
                <p class="user-settings-description">Defina a nova senha dos usuários que solicitaram alteração.</p>
            </div>

            @if (_passwordRequests.Count == 0)
            {
                <p class="user-settings-description">Nenhuma solicitação pendente.</p>
            }
            else
            {
                <div class="user-settings-requests">
                    @foreach (var request in _passwordRequests)
                    {
                        <div class="user-settings-request">
                            <div class="user-settings-request-user">
                                <strong>@request.Name</strong>
                                <small>@request.Username @(!string.IsNullOrWhiteSpace(request.Email) ? $"• {request.Email}" : "")</small>
                            </div>

                            <input class="user-settings-input"
                                   type="password"
                                   placeholder="Nova senha"
                                   value="@GetNewPassword(request.Username)"
                                   @oninput="eventArgs => SetNewPassword(request.Username, eventArgs.Value?.ToString() ?? string.Empty)" />

                            <button type="button"
                                    class="user-settings-button"
                                    disabled="@_saving"
                                    @onclick="() => ChangePasswordAsync(request.Username)">
                                Alterar senha
                            </button>
                        </div>
                    }
                </div>
            }
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="user-settings-message">@_message</p>
    }
}

@code {
    [SupplyParameterFromQuery] public bool AdminPasswordRequests { get; set; }

    private UserProfileSettings? _profile;
    private List<UserPasswordChangeRequest> _passwordRequests = new();
    private readonly Dictionary<string, string> _newPasswords = new(StringComparer.OrdinalIgnoreCase);
    private string _name = "";
    private string _avatarDataUrl = "";
    private string? _message;
    private bool _loading = true;
    private bool _saving;

    private string Initials
    {
        get
        {
            var source = string.IsNullOrWhiteSpace(_name) ? "U" : _name;
            var initials = string.Concat(source
                .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Take(2)
                .Select(part => part[0].ToString().ToUpperInvariant()));

            return string.IsNullOrWhiteSpace(initials) ? "U" : initials;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/Login", replace: true);
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _profile = await UserSettingsService.GetCurrentProfileAsync();
        if (_profile is not null)
        {
            _name = _profile.Name;
            _avatarDataUrl = _profile.AvatarDataUrl;
        }

        if (AuthService.IsAdmin)
            _passwordRequests = await UserSettingsService.GetPendingPasswordRequestsAsync();

        _loading = false;
    }

    private async Task UploadAvatarAsync(InputFileChangeEventArgs eventArgs)
    {
        var file = eventArgs.File;
        if (file.Size > 1024 * 1024)
        {
            _message = "A imagem deve ter no máximo 1 MB.";
            return;
        }

        await using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        _avatarDataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(memoryStream.ToArray())}";
        _message = null;
    }

    private async Task SaveProfileAsync()
    {
        _saving = true;
        try
        {
            await UserSettingsService.UpdateCurrentProfileAsync(_name, _avatarDataUrl);
            _message = "Perfil atualizado.";
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RequestPasswordChangeAsync()
    {
        _saving = true;
        try
        {
            await UserSettingsService.RequestPasswordChangeAsync();
            _message = "Solicitação enviada ao administrador.";
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private string GetNewPassword(string username) =>
        _newPasswords.TryGetValue(username, out var password) ? password : "";

    private void SetNewPassword(string username, string password) =>
        _newPasswords[username] = password;

    private async Task ChangePasswordAsync(string username)
    {
        _saving = true;
        try
        {
            await UserSettingsService.ChangeUserPasswordAsync(username, GetNewPassword(username));
            _newPasswords.Remove(username);
            _message = "Senha alterada.";
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
