@page "/StockAnalysis"
@attribute [Authorize(Roles = "Admin,Farmacia,Almoxarifado,Consulta")]

<PageTitle>Análise de Estoque | RepyPharma</PageTitle>

<div class="stock-analysis">
    <header class="sa-module-header">
        <div><div class="sa-eyebrow">GESTÃO HOSPITALAR · INTELIGÊNCIA DE ESTOQUE</div><h1><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Análise de Estoque</h1><p>Consumo, impacto financeiro e criticidade em uma visão integrada.</p></div>
        <div class="sa-header-context"><span class="sa-demo-notice"><span class="sa-status-dot"></span> Ambiente demonstrativo — Dados fictícios</span><span class="sa-period-label"><i class="bi bi-calendar3" aria-hidden="true"></i> Referência simulada · novembro de 2026</span></div>
    </header>
    <nav class="sa-tabs" role="tablist" aria-label="Seções da análise de estoque">
        @for (var index = 0; index < TabLabels.Length; index++)
        {
            var tab = index;
            <button type="button" role="tab" id="@($"sa-tab-{tab}")" aria-controls="@($"sa-panel-{tab}")" aria-selected="@(tab == _activeTab ? "true" : "false")" class="sa-tab @(tab == _activeTab ? "is-active" : null)" @onclick="() => _activeTab = tab"><i class="bi @TabIcons[tab]" aria-hidden="true"></i> @TabLabels[tab]</button>
        }
    </nav>
    <section id="sa-panel-0" role="tabpanel" aria-labelledby="sa-tab-0" hidden="@(_activeTab != 0)"><StockOverview Items="_items" FinancialMonths="_financialMonths" Distribution="_distribution" OnSelectItem="OpenItem" /></section>
    <section id="sa-panel-1" role="tabpanel" aria-labelledby="sa-tab-1" hidden="@(_activeTab != 1)"><StockItemAnalysis Items="_items" SelectedItemId="_selectedItemId" SelectedItemIdChanged="SelectItem" /></section>
    <section id="sa-panel-2" role="tabpanel" aria-labelledby="sa-tab-2" hidden="@(_activeTab != 2)"><StockAbcXyzAnalysis Items="_items" Matrix="_matrix" OnSelectItem="OpenItem" /></section>
    <section id="sa-panel-3" role="tabpanel" aria-labelledby="sa-tab-3" hidden="@(_activeTab != 3)"><StockConsumptionAlerts Items="_items" Alerts="_alerts" OnSelectItem="OpenItem" /></section>
    <footer class="sa-module-footer"><i class="bi bi-info-circle" aria-hidden="true"></i> Prévia para avaliação do módulo. Classificações, indicadores e projeções são ilustrativos; nenhuma informação é gravada.</footer>
</div>

@code {
    public static readonly CultureInfo Br = CultureInfo.GetCultureInfo("pt-BR");
    public static readonly DateOnly ReferenceDate = new(2026, 11, 30);
    public static readonly Guid DemoAnalysisId = Guid.Parse("beed7b8b-39a7-42ce-9f01-202611300001");
    private static readonly string[] TabLabels = ["Visão Geral", "Análise por Item", "Classificação ABC/XYZ", "Alertas"];
    private static readonly string[] TabIcons = ["bi-grid-1x2", "bi-capsule", "bi-diagram-3", "bi-bell"];
    private int _activeTab;
    private int _selectedItemId = 1;
    private IReadOnlyList<DemoItem> _items = [];
    private IReadOnlyList<DemoAlert> _alerts = [];
    private IReadOnlyList<decimal> _financialMonths = [];
    private AbcDistributionDto _distribution = new();
    private AbcXyzMatrixDto _matrix = new();

    public static string Money(decimal? value) => value?.ToString("C2", Br) ?? "—";
    public static string Number(decimal? value) => value?.ToString("N0", Br) ?? "—";
    public static string DecimalNumber(decimal? value) => value?.ToString("N2", Br) ?? "—";
    public static string Percent(decimal? value) => value is null ? "—" : (value > 0 ? "+" : "") + value.Value.ToString("N1", Br) + "%";
    public static string ClassLabel(XyzCriticality? value) => value?.ToString() ?? "Sem XYZ";
    public static string AbcClass(AbcClassification value) => "sa-badge sa-abc-" + value.ToString().ToLowerInvariant();
    public static string XyzClass(XyzCriticality? value) => "sa-badge sa-xyz-" + (value?.ToString().ToLowerInvariant() ?? "none");
    public static bool Matches(ItemReferenceDto item, string search) => string.IsNullOrWhiteSpace(search) || Br.CompareInfo.IndexOf(item.Code + " " + item.Name, search.Trim(), CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0;
    public static DateRangeDto DemoPeriod() => new() { StartDate = new(2026, 11, 1), EndDate = ReferenceDate };

    private void SelectItem(int itemId) => _selectedItemId = itemId;
    private void OpenItem(int itemId) { _selectedItemId = itemId; _activeTab = 1; }

    protected override void OnInitialized()
    {
        // Fixtures fixas. Não há serviços, acesso a dados reais ou algoritmos de análise.
        _items = BuildItems();
        // Saldos e autonomias previamente definidos para a demonstração.
        var stockCoverage = new (int ItemId, decimal AvailableQuantity, decimal? CoverageDays)[]
        {
            (1, 800m, 8m), (2, 880m, 12m), (3, 64000m, 24m),
            (4, 90000m, 45m), (5, 600m, 3m), (6, 6000m, 18m),
            (7, 15000m, 15m), (8, 500m, null), (9, 7450m, 14.9m),
            (10, 10000m, 30m), (11, 0m, 0m), (12, 3500m, 15m)
        };
        foreach (var coverage in stockCoverage)
        {
            var item = _items.Single(i => i.Item.ItemId == coverage.ItemId);
            item.Analysis.StockCoverage = new()
            {
                ItemId = coverage.ItemId,
                ReferenceDate = ReferenceDate,
                AvailableQuantity = coverage.AvailableQuantity,
                AverageDailyConsumption = item.Analysis.Consumption?.AverageDailyConsumption,
                CoverageDays = coverage.CoverageDays
            };
        }
        _financialMonths = new decimal[] { 680000.000m, 710000.000m, 690000.000m, 740000.000m, 760000.000m, 790000.000m, 820000.000m, 850000.000m, 880000.000m, 910000.000m, 907751.629m, 1000000m };
        _distribution = new() { AnalysisId = DemoAnalysisId, Period = DemoPeriod(), TotalItems = 12, TotalConsumptionValue = 1_000_000m, Classes = [
            new() { Classification = AbcClassification.A, ItemCount = 4, ItemPercentage = 33.333m, ConsumptionValue = 800_000m, FinancialPercentage = 80m },
            new() { Classification = AbcClassification.B, ItemCount = 4, ItemPercentage = 33.333m, ConsumptionValue = 160_000m, FinancialPercentage = 16m },
            new() { Classification = AbcClassification.C, ItemCount = 4, ItemPercentage = 33.334m, ConsumptionValue = 40_000m, FinancialPercentage = 4m }] };
        _matrix = new() { AbcAnalysisId = DemoAnalysisId, Period = DemoPeriod(), Cells = [
            new() { AbcClassification = AbcClassification.A, Criticality = XyzCriticality.X, ItemCount = 1, ConsumptionValue = 160_000m },
            new() { AbcClassification = AbcClassification.A, Criticality = XyzCriticality.Y, ItemCount = 1, ConsumptionValue = 120_000m },
            new() { AbcClassification = AbcClassification.A, Criticality = XyzCriticality.Z, ItemCount = 2, ConsumptionValue = 520_000m },
            new() { AbcClassification = AbcClassification.B, Criticality = XyzCriticality.X, ItemCount = 1, ConsumptionValue = 30_000m },
            new() { AbcClassification = AbcClassification.B, Criticality = XyzCriticality.Y, ItemCount = 1, ConsumptionValue = 50_000m },
            new() { AbcClassification = AbcClassification.B, Criticality = XyzCriticality.Z, ItemCount = 1, ConsumptionValue = 60_000m },
            new() { AbcClassification = AbcClassification.C, Criticality = XyzCriticality.X, ItemCount = 1, ConsumptionValue = 15_000m },
            new() { AbcClassification = AbcClassification.C, Criticality = XyzCriticality.Y, ItemCount = 1, ConsumptionValue = 10_000m },
            new() { AbcClassification = AbcClassification.C, Criticality = XyzCriticality.Z, ItemCount = 1, ConsumptionValue = 8_000m }] };
        _alerts = [
            Alert(1, "critical-growth", "Alta criticidade com consumo crescente", AnalysisSeverity.Critical, 25m, "Crescimento no mês de referência em um item de criticidade Z.", "Conferir movimentações e contexto assistencial com a equipe responsável."),
            Alert(2, "growth", "Aumento de consumo frente ao histórico", AnalysisSeverity.Warning, 18m, "A amostra indica consumo acima do mês anterior.", "Verificar registros de consumo e possíveis mudanças no perfil de atendimento."),
            Alert(5, "daily-spike", "Consumo diário excepcional", AnalysisSeverity.Critical, 80m, "Pico ilustrativo em 24/11: 360 unidades frente à referência de 200.", "Investigar o registro do dia e conferir se houve lançamento concentrado.", 24),
            Alert(6, "reduction", "Redução significativa do consumo", AnalysisSeverity.Warning, -22m, "O consumo mensal da amostra recuou frente ao mês anterior.", "Conferir a completude dos registros e as condições de atendimento."),
            Alert(8, "insufficient", "Histórico insuficiente", AnalysisSeverity.Warning, null, "Apenas 14 dias de registros diários estão disponíveis nesta amostra.", "Completar o histórico antes de interpretar tendências e projeções."),
            Alert(11, "no-movement", "Ausência prolongada de movimentação", AnalysisSeverity.Warning, -100m, "Não há consumo nos oito últimos dias da série fictícia.", "Verificar registros, disponibilidade e utilização com a equipe responsável."),
