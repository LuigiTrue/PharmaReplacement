    private DemoAlert Alert(int itemId, string category, string title, AnalysisSeverity severity, decimal? variation, string context, string review, int day = 30)
    {
        var item = _items.First(i => i.Item.ItemId == itemId);
        return new() { Data = new() { Item = item.Item, Code = category, Description = title, Severity = severity, Period = DemoPeriod(), VariationPercentage = variation,
            ObservedValue = category == "daily-spike" ? 360m : category == "no-movement" ? 0m : item.Analysis.Consumption!.TotalQuantity,
            ReferenceValue = category == "daily-spike" ? 200m : null }, IdentifiedAt = new(2026, 11, day), Context = context, SuggestedReview = review };
    }

    public sealed class DemoItem
    {
        public ItemAnalysisDto Analysis { get; init; } = new();
        public ItemReferenceDto Item => Analysis.Item;
        public AbcClassificationDto Abc => Analysis.AbcClassification!;
        public XyzCriticality? Xyz => Analysis.Criticality?.Criticality;
        public decimal Variation { get; init; }
        public decimal Share { get; init; }
        public decimal? Average90 { get; init; }
        public decimal? Average180 { get; init; }
        public IReadOnlyList<MonthlyConsumptionDto> Monthly { get; init; } = [];
        public IReadOnlyList<DailyConsumptionDto> Daily { get; init; } = [];
        public MovingAverageDto Moving7 { get; init; } = new();
        public MovingAverageDto Moving30 { get; init; } = new();
        public IReadOnlyList<AbcClassificationDto> AbcHistory { get; init; } = [];
        public IReadOnlyList<decimal> HistoryShares { get; init; } = [];
        public IReadOnlyList<decimal> Projections { get; init; } = [];
        public ForecastComparisonDto ForecastComparison { get; init; } = new();
        public YearOverYearComparisonDto YearComparison { get; init; } = new();
    }
    public sealed class DemoAlert
    {
        public ConsumptionAlertDto Data { get; init; } = new();
        public DateOnly IdentifiedAt { get; init; }
        public string Context { get; init; } = "";
        public string SuggestedReview { get; init; } = "";
    }

    private static DemoItem CreateItem(int id, string code, string name, ItemType type, AbcClassification abc, XyzCriticality? xyz,
        decimal quantity, decimal price, decimal variation, decimal share, decimal accumulated, decimal average30, decimal? average90, decimal? average180,
        decimal[] monthly, decimal[] monthlyAverages, decimal[] daily, decimal[] moving7, decimal[] moving30, decimal[] projections, decimal?[] comparisons, decimal[] historyShares, int[] historyPositions)
    {
        var item = new ItemReferenceDto { ItemId = id, Code = code, Name = name, Unit = type == ItemType.Material && id == 3 ? "cx" : "un.", ItemType = type };
        var classification = new AbcClassificationDto { Id = id, AnalysisId = DemoAnalysisId, Item = item, Period = DemoPeriod(), Position = id, ConsumptionValue = quantity * price, Classification = abc, AccumulatedPercentage = accumulated };
        var months = monthly.Select((q, i) => new MonthlyConsumptionDto { Id = id * 100 + i, ItemId = id, Year = i == 0 ? 2025 : 2026, Month = i == 0 ? 12 : i, TotalQuantity = q, AverageDailyConsumption = monthlyAverages[i], UnitPurchasePrice = price }).ToArray();
        var days = daily.Select((q, i) => new DailyConsumptionDto { Id = id * 1000 + i, ItemId = id, Date = ReferenceDate.AddDays(i - daily.Length + 1), Quantity = q }).ToArray();
        MovingAverageDto Moving(int window, decimal[] values) => new() { ItemId = id, WindowSize = window, Granularity = ConsumptionGranularity.Daily, Period = new() { StartDate = ReferenceDate.AddDays(1 - Math.Max(1, values.Length)), EndDate = ReferenceDate }, Points = values.Select((q, i) => new ConsumptionSeriesPointDto { Date = ReferenceDate.AddDays(i - values.Length + 1), Quantity = q }).ToArray() };
        var forecast = new ConsumptionForecastDto { ItemId = id, Method = new() { MethodCode = "media-30-dias" }, HistoryPeriod = DemoPeriod(), ForecastPeriod = new() { StartDate = new(2026, 12, 1), EndDate = new(2027, 1, 14) }, TotalQuantity = projections[2] };
        var analysis = new ItemAnalysisDto { Item = item, AbcClassification = classification, Criticality = new() { Item = item, Criticality = xyz }, Forecast = forecast,
            Consumption = new() { ItemId = id, Period = DemoPeriod(), TotalQuantity = quantity, AverageDailyConsumption = average30, ConsumptionValue = quantity * price, RecordedDays = id == 8 ? 14 : 30 },
            DataQuality = new() { Period = DemoPeriod(), ItemCount = 1, ItemsWithHistory = 1, ItemsWithInsufficientHistory = id == 8 ? 1 : 0 } };
        return new() { Analysis = analysis, Variation = variation, Share = share, Average90 = average90, Average180 = average180,
            Monthly = id == 8 ? months.TakeLast(2).ToArray() : months, Daily = days, Moving7 = Moving(7, moving7), Moving30 = Moving(30, moving30), HistoryShares = historyShares, Projections = projections,
            AbcHistory = Enumerable.Range(0, 3).Select(i => new AbcClassificationDto { Id = id * 10 + i, Item = item, AnalysisId = i == 2 ? DemoAnalysisId : Guid.Parse(i == 0 ? "beed7b8b-39a7-42ce-9f01-202609300001" : "beed7b8b-39a7-42ce-9f01-202610310001"),
                Period = new() { StartDate = new(2026, 9 + i, 1), EndDate = new(2026, 9 + i, DateTime.DaysInMonth(2026, 9 + i)) }, Classification = id == 3 && i == 1 ? AbcClassification.B : abc,
                ConsumptionValue = monthly[9 + i] * price, Position = historyPositions[i] }).ToArray(),
            ForecastComparison = new() { ItemId = id, Forecasts = comparisons.Select((value, i) => new ConsumptionForecastDto { ItemId = id, Method = new() { MethodCode = new[] { "media-30-dias", "media-90-dias", "media-180-dias" }[i] }, HistoryPeriod = new() { StartDate = new[] { new DateOnly(2026, 11, 1), new DateOnly(2026, 9, 2), new DateOnly(2026, 6, 4) }[i], EndDate = ReferenceDate }, ForecastPeriod = forecast.ForecastPeriod, TotalQuantity = value }).ToArray() },
            YearComparison = new() { ItemId = id, ReferenceSeries = YearSeries(id), ComparisonSeries = monthly.Skip(1).Select((q, i) => new ConsumptionSeriesPointDto { Date = new(2026, i + 1, 1), Quantity = q }).ToArray() } };
    }

