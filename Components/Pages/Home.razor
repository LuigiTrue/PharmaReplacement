@page "/"
@inject IProductStockService ProductStockService
@inject IGridColumnService ColumnService



<PageTitle>Home</PageTitle>

<GridComponent TItem="ProductStock" Items="_data" Columns="Columns" />

@code {
    private List<ProductStock>? Data = new();
    private IQueryable<ProductStock>? _data;
    private List<GridColumnDefinition<ProductStock>> Columns = new();

    protected override async Task OnInitializedAsync()
    {
        Data = await ProductStockService.GetProductStocksAsync();
        _data = Data.AsQueryable();

        Columns = ColumnService.Generate<ProductStock>(
        x => x.Name,
        x => x.Unit,
        x => x.TotalStock
        );
    }
}